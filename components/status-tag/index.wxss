.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.primary {
  color: #1f5fbf;
  background: #eaf2ff;
}

.info {
  color: #28618f;
  background: #e7f5ff;
}

.warning {
  color: #9a5b00;
  background: #fff4df;
}

.success {
  color: #16733f;
  background: #e8f7ef;
}

.danger {
  color: #b3261e;
  background: #fdecea;
}

.muted {
  color: #667085;
  background: #eef1f5;
}

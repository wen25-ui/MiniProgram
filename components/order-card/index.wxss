.card {
  background: #fff;
  border: 1rpx solid #e7ebf2;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  color: #102033;
  font-size: 32rpx;
  font-weight: 800;
}

.phone {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
}

.meta {
  margin-top: 20rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef1f5;
}

.bottom view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.muted {
  color: #8a95a8;
  font-size: 24rpx;
}

.money {
  color: #c56b00;
  font-weight: 800;
}

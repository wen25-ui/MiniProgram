.nav{position:fixed;z-index:30;left:18rpx;right:18rpx;bottom:calc(12rpx + env(safe-area-inset-bottom));height:104rpx;display:flex;overflow:hidden;border:1rpx solid rgba(221,228,237,.9);border-radius:26rpx;background:rgba(255,255,255,.98);box-shadow:0 10rpx 34rpx rgba(16,32,51,.13)}.nav-item{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#929eac}.nav-item.active::before{content:'';position:absolute;top:0;width:54rpx;height:5rpx;border-radius:0 0 5rpx 5rpx;background:#1677c8}.nav-icon{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid currentColor;border-radius:13rpx;font-size:19rpx;font-weight:800;line-height:40rpx}.nav-label{margin-top:6rpx;font-size:20rpx;line-height:26rpx}.nav-item.active{background:linear-gradient(180deg,rgba(235,246,255,.8),rgba(255,255,255,0));color:#1677c8;font-weight:700}

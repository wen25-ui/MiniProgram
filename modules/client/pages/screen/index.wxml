<view class="page">
  <view wx:if="{{!hasMerchantInvite}}" class="access-mask">
    <view class="access-card">
      <text class="access-icon">⌁</text>
      <text class="access-title">请先扫描商家二维码</text>
      <text class="access-desc">客户无法自主发起资料申请，请从商家提供的专属二维码进入办理流程。</text>
    </view>
  </view>
  <view class="intro-card">
    <text class="intro-tag">在线申请</text>
    <text class="intro-title">办理资格申请</text>
    <text class="intro-desc">请如实填写以下信息，提交后由客服进行资格复审。</text>
    <view class="step-overview">
      <view class="overview-item active"><text>1</text><text>联系方式</text></view><view class="overview-line"></view>
      <view class="overview-item"><text>2</text><text>办理意愿</text></view><view class="overview-line"></view>
      <view class="overview-item"><text>3</text><text>话费与承诺</text></view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-head"><view class="step-number">1</view><view><text class="section-title">联系方式</text><text class="section-desc">手动填写本人常用手机号</text></view></view>
    <text class="field-label">手机号</text>
    <input class="phone-input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入 11 位手机号" bindinput="onPhoneInput" />
    <view class="question-block">
      <text class="question-title">号码是否为本地号码？</text>
      <view class="answer-row">
        <view class="answer {{localNumber === 'YES' ? 'selected' : ''}}" data-value="YES" bindtap="chooseLocalNumber">是</view>
        <view class="answer {{localNumber === 'NO' ? 'selected' : ''}}" data-value="NO" bindtap="chooseLocalNumber">否</view>
      </view>
    </view>
    <view wx:if="{{localNumber === 'NO'}}" class="question-block conditional">
      <text class="question-title">是否接受新开卡？</text>
      <view class="answer-row">
        <view class="answer {{acceptLocalCard === 'YES' ? 'selected' : ''}}" data-value="YES" bindtap="chooseAcceptLocalCard">是</view>
        <view class="answer {{acceptLocalCard === 'NO' ? 'selected' : ''}}" data-value="NO" bindtap="chooseAcceptLocalCard">否</view>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-head"><view class="step-number">2</view><view><text class="section-title">套餐与履约确认</text><text class="section-desc">选择个人（全家）套餐档位并确认办理要求</text></view></view>
    <text class="field-label">个人（全家）套餐档位</text>
    <view class="tier-list"><view wx:for="{{expenseTiers}}" wx:key="value" class="tier {{expenseTier === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseExpenseTier">{{item.label}}</view></view>
    <view class="rule-tip"><text class="tip-icon">i</text><text>返现档位与最终资格，以客服复审和实际活动规则为准。</text></view>
    <text class="commitment-heading">请确认以下履约要求</text>
    <view class="commitment" data-index="0" bindtap="toggleCommitment"><view class="checkbox {{commitments[0] ? 'checked' : ''}}">{{commitments[0] ? '✓' : ''}}</view><text>三年内不销户</text></view>
    <view class="commitment" data-index="1" bindtap="toggleCommitment"><view class="checkbox {{commitments[1] ? 'checked' : ''}}">{{commitments[1] ? '✓' : ''}}</view><text>三年内不转网</text></view>
    <view class="commitment" data-index="2" bindtap="toggleCommitment"><view class="checkbox {{commitments[2] ? 'checked' : ''}}">{{commitments[2] ? '✓' : ''}}</view><text>三年内不降套餐</text></view>
  </view>

  <view wx:if="{{result}}" class="result {{result.passed ? 'success' : 'warning'}}">
    <text class="result-title">{{result.passed ? '资格申请已提交' : '资料暂未提交'}}</text>
    <text wx:if="{{result.passed}}" class="result-text">资料已进入客服复审队列，请在业务进度中查看后续状态。</text>
    <block wx:else><text wx:for="{{result.reasons}}" wx:key="*this" class="result-text">{{item}}</text></block>
    <button wx:if="{{result.passed}}" class="back-button" bindtap="backHome">返回用户端</button>
  </view>

  <view class="submit-area">
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting || !allCommitmentsAccepted || !hasMerchantInvite}}" bindtap="submit">提交申请资料</button>
    <text wx:if="{{!hasMerchantInvite}}">请先扫描商家提供的二维码进入申请流程</text>
    <text wx:elif="{{allCommitmentsAccepted}}">已确认全部履约要求，可以提交申请</text>
    <text wx:else>请先勾选全部三项履约要求</text>
  </view>
</view>

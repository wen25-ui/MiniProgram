.page { min-height: 100vh; padding: 28rpx 28rpx 50rpx; box-sizing: border-box; background: #f4f7fb; }
.intro-card { padding: 34rpx; border-radius: 30rpx; background: linear-gradient(135deg,#1677c8,#55b9e9); color: #fff; box-shadow: 0 14rpx 32rpx rgba(22,119,200,.18); }.intro-tag { display: block; font-size: 23rpx; opacity: .88; }.intro-title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }.intro-desc { display: block; margin-top: 14rpx; font-size: 24rpx; line-height: 1.55; opacity: .9; }
.step-overview { margin-top: 30rpx; display: flex; align-items: flex-start; }.overview-item { width: 116rpx; display: flex; flex-direction: column; align-items: center; font-size: 20rpx; opacity: .7; }.overview-item text:first-child { width: 38rpx; height: 38rpx; margin-bottom: 8rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.2); font-weight: 700; }.overview-item.active { opacity: 1; }.overview-item.active text:first-child { background: #fff; color: #1677c8; }.overview-line { flex: 1; height: 3rpx; margin-top: 18rpx; background: rgba(255,255,255,.3); }
.form-card { margin-top: 24rpx; padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(27,53,82,.05); }.section-head { margin-bottom: 28rpx; display: flex; align-items: center; }.step-number { width: 54rpx; height: 54rpx; margin-right: 18rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #e5f4ff; color: #1677c8; font-size: 26rpx; font-weight: 700; }.section-title { display: block; color: #17283c; font-size: 31rpx; font-weight: 700; }.section-desc { display: block; margin-top: 5rpx; color: #97a3b1; font-size: 21rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #41556b; font-size: 24rpx; font-weight: 600; }.phone-input { height: 88rpx; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid #dce4ec; border-radius: 14rpx; background: #fbfcfe; box-sizing: border-box; }
.question-block { margin-top: 24rpx; padding: 24rpx; border-radius: 18rpx; background: #f5f9fc; }.question-block.conditional { border: 1rpx solid #cfe8f6; background: #f0f9fe; }.question-title { display: block; margin-bottom: 18rpx; color: #34495f; font-size: 26rpx; font-weight: 600; }.answer-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.answer { height: 76rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #dce4ec; border-radius: 14rpx; background: #fff; color: #617287; font-size: 26rpx; }.answer.selected { border-color: #2e94d0; background: #e5f5fd; color: #1677c8; font-weight: 700; }.resident-row { margin-top: 4rpx; }
.query-row { margin-top: 20rpx; padding: 22rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 16rpx; background: #f5f9fc; }.query-copy { padding-right: 16rpx; display: flex; flex-direction: column; }.query-title { color: #34495f; font-size: 25rpx; font-weight: 600; }.query-message { margin-top: 7rpx; color: #8997a8; font-size: 21rpx; line-height: 1.4; }.location { margin-top: 7rpx; color: #1677c8; font-size: 23rpx; font-weight: 600; }.query-button { width: 136rpx; height: 68rpx; margin: 0; flex: none; border-radius: 12rpx; background: #e3f3fc; color: #1677c8; font-size: 25rpx; line-height: 68rpx; }.query-button::after { border: 0; }
.option-list { display: flex; flex-direction: column; gap: 16rpx; }.option { min-height: 84rpx; padding: 0 22rpx; display: flex; align-items: center; border: 2rpx solid #e0e6ed; border-radius: 14rpx; color: #53667a; font-size: 26rpx; }.option.selected { border-color: #3698d2; background: #f0f9fe; color: #1677c8; font-weight: 600; }.radio { width: 34rpx; height: 34rpx; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #c8d1dc; border-radius: 50%; box-sizing: border-box; }.radio.checked { border-color: #1677c8; }.radio.checked view { width: 16rpx; height: 16rpx; border-radius: 50%; background: #1677c8; }
.tier-list { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.tier { min-height: 76rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #e0e6ed; border-radius: 14rpx; color: #607287; font-size: 25rpx; }.tier.selected { border-color: #3698d2; background: #eaf7fd; color: #1677c8; font-weight: 600; }
.rule-tip { margin-top: 20rpx; padding: 18rpx; display: flex; align-items: flex-start; border-radius: 14rpx; background: #f4f9fc; color: #7d8d9f; font-size: 21rpx; line-height: 1.5; }.tip-icon { width: 30rpx; height: 30rpx; margin-right: 12rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #dceffa; color: #1677c8; font-weight: 700; }.commitment-heading { display: block; margin: 28rpx 0 12rpx; color: #34495f; font-size: 25rpx; font-weight: 600; }.commitment { min-height: 70rpx; display: flex; align-items: center; color: #576a7e; font-size: 25rpx; border-bottom: 1rpx solid #edf0f4; }.commitment:last-child { border-bottom: 0; }.checkbox { width: 36rpx; height: 36rpx; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #cdd6df; border-radius: 8rpx; box-sizing: border-box; color: #fff; font-size: 24rpx; }.checkbox.checked { border-color: #1677c8; background: #1677c8; }
.result { margin-top: 24rpx; padding: 28rpx; border-radius: 22rpx; }.result.success { background: #eaf8f2; border: 1rpx solid #bfe8d5; }.result.warning { background: #fff7e9; border: 1rpx solid #f2d6a4; }.result-title { display: block; color: #263a4d; font-size: 29rpx; font-weight: 700; }.result-text { display: block; margin-top: 10rpx; color: #65778a; font-size: 23rpx; line-height: 1.55; }.back-button { margin-top: 20rpx; background: #fff; color: #1677c8; font-size: 25rpx; }
.submit-area { margin-top: 24rpx; padding: 26rpx 30rpx; display: flex; flex-direction: column; align-items: center; border-radius: 24rpx; background: #fff; }.submit-button { width: 100%; height: 86rpx; border-radius: 14rpx; background: #1677c8; color: #fff; font-size: 29rpx; font-weight: 600; line-height: 86rpx; }.submit-button::after { border: 0; }.submit-area > text { margin-top: 14rpx; color: #9aa6b4; font-size: 20rpx; }
.submit-button[disabled] { background: #b9c7d4; color: #f5f7fa; }
.access-mask { position: fixed; inset: 0; z-index: 80; padding: 220rpx 42rpx 0; background: rgba(244,247,251,.97); box-sizing: border-box; }
.access-card { padding: 48rpx 36rpx; display: flex; flex-direction: column; align-items: center; border: 1rpx solid #dceaf5; border-radius: 28rpx; background: #fff; box-shadow: 0 16rpx 42rpx rgba(27,53,82,.10); text-align: center; }
.access-icon { width: 86rpx; height: 86rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #e5f4ff; color: #1677c8; font-size: 52rpx; font-weight: 700; }
.access-title { margin-top: 26rpx; color: #17283c; font-size: 32rpx; font-weight: 700; }
.access-desc { margin-top: 14rpx; color: #8190a2; font-size: 24rpx; line-height: 1.65; }

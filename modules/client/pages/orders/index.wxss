.page { min-height: 100vh; padding: 28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f4f7fb; }
.header-card { min-height: 190rpx; padding: 34rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-radius: 30rpx; background: linear-gradient(135deg,#1677c8,#55b9e9); color: #fff; box-shadow: 0 14rpx 32rpx rgba(22,119,200,.18); }
.eyebrow { display: block; font-size: 23rpx; opacity: .88; }.page-title { display: block; margin-top: 8rpx; font-size: 39rpx; font-weight: 700; }.header-desc { display: block; margin-top: 14rpx; font-size: 23rpx; opacity: .86; }
.header-icon { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: rgba(255,255,255,.18); font-size: 42rpx; }
.application-list { margin-top: 24rpx; }.application-card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(27,53,82,.06); }
.card-head { display: flex; justify-content: space-between; align-items: flex-start; }.order-label { display: block; color: #95a1b1; font-size: 21rpx; }.id { display: block; margin-top: 5rpx; color: #26374b; font-size: 25rpx; font-weight: 600; }.status { padding: 9rpx 16rpx; border-radius: 26rpx; background: #e8f5ff; color: #1677c8; font-size: 22rpx; font-weight: 600; }
.description { display: block; margin: 24rpx 0; color: #52657a; font-size: 25rpx; line-height: 1.55; }
.progress-head { display: flex; justify-content: space-between; color: #77879a; font-size: 21rpx; }.progress-track { height: 12rpx; margin-top: 12rpx; overflow: hidden; border-radius: 8rpx; background: #e8edf2; }.progress-value { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg,#1677c8,#58bee9); }
.stage-row { margin-top: 10rpx; display: flex; justify-content: space-between; color: #a1acb9; font-size: 20rpx; }.stage-row .done { color: #1677c8; font-weight: 600; }
.details { margin-top: 24rpx; padding: 10rpx 20rpx; border-radius: 16rpx; background: #f7f9fc; }.detail-row { min-height: 68rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e9edf2; }.detail-row:last-child { border-bottom: 0; }.detail-label { color: #7b899a; font-size: 23rpx; }.detail-value { color: #34475b; font-size: 23rpx; }.highlight { color: #168960; font-weight: 600; }
.time { display: block; margin-top: 18rpx; color: #a1acb9; font-size: 20rpx; text-align: right; }
.detail-button { height: 72rpx; margin-top: 20rpx; border-radius: 12rpx; background: #edf7fd; color: #1677c8; font-size: 25rpx; line-height: 72rpx; }.detail-button::after { border: 0; }
.state-card,.empty-card { margin-top: 24rpx; padding: 70rpx 40rpx; display: flex; flex-direction: column; align-items: center; border-radius: 26rpx; background: #fff; color: #718095; }.loading-ring { width: 52rpx; height: 52rpx; margin-bottom: 20rpx; border: 6rpx solid #dceefa; border-top-color: #1677c8; border-radius: 50%; animation: spin .8s linear infinite; }
.empty-illustration { width: 132rpx; height: 132rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eaf6fc; }.empty-file { width: 62rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #65b5df; border-radius: 10rpx; color: #1677c8; font-size: 36rpx; }.empty-title { margin-top: 28rpx; color: #17283c; font-size: 32rpx; font-weight: 700; }.empty-text { margin-top: 14rpx; color: #7e8c9d; font-size: 24rpx; line-height: 1.6; text-align: center; }.error-text { margin-top: 12rpx; color: #b54708; font-size: 22rpx; }.primary-action { width: 100%; margin-top: 34rpx; border-radius: 14rpx; background: #1677c8; color: #fff; }.primary-action::after { border: 0; }
@keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

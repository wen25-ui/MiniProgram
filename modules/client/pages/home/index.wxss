.page { min-height: 100vh; padding: 28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f4f7fb; }
.hero { position: relative; min-height: 210rpx; padding: 38rpx 34rpx; display: flex; align-items: center; justify-content: space-between; overflow: hidden; box-sizing: border-box; border-radius: 30rpx; background: linear-gradient(135deg, #1677c8, #55b9e9); box-shadow: 0 14rpx 32rpx rgba(22,119,200,.2); color: #fff; }
.hero::after { content: ''; position: absolute; right: -70rpx; top: -90rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(255,255,255,.1); }
.hero-copy { position: relative; z-index: 1; display: flex; flex-direction: column; }
.welcome { font-size: 25rpx; opacity: .9; }
.hero-title { margin-top: 12rpx; font-size: 40rpx; line-height: 1.35; font-weight: 700; }
.phone { margin-top: 18rpx; font-size: 24rpx; opacity: .88; }
.hero-mark { position: relative; z-index: 1; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.35); font-size: 38rpx; font-weight: 700; }
.apply-card { margin-top: 24rpx; padding: 32rpx 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(27,53,82,.06); }
.apply-head { display: flex; align-items: flex-start; justify-content: space-between; }
.section-tag { display: block; color: #1677c8; font-size: 23rpx; font-weight: 600; }
.apply-title { display: block; margin-top: 8rpx; color: #102033; font-size: 34rpx; font-weight: 700; }
.status-pill { padding: 9rpx 16rpx; border-radius: 30rpx; background: #eef2f6; color: #738096; font-size: 22rpx; }
.status-pill.processing { background: #e8f5ff; color: #1677c8; }
.summary { display: block; margin-top: 20rpx; color: #66768a; font-size: 25rpx; line-height: 1.55; }
.process { margin: 30rpx 4rpx 26rpx; display: flex; align-items: flex-start; }
.process-item { width: 110rpx; display: flex; flex-direction: column; align-items: center; color: #9aa6b4; font-size: 21rpx; white-space: nowrap; }
.dot { width: 42rpx; height: 42rpx; margin-bottom: 9rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e8edf2; color: #8190a1; font-size: 22rpx; font-weight: 700; }
.process-item.active { color: #1677c8; }
.process-item.active .dot { background: #1677c8; color: #fff; }
.line { flex: 1; height: 4rpx; margin-top: 19rpx; background: #e8edf2; }
.line.active-line { background: #7bc4eb; }
.primary-action { height: 84rpx; border-radius: 14rpx; background: #1677c8; color: #fff; font-size: 29rpx; font-weight: 600; line-height: 84rpx; }
.primary-action.no-progress { margin-top: 30rpx; }
.primary-action::after { border: 0; }
.section-head { margin: 34rpx 4rpx 18rpx; display: flex; align-items: baseline; justify-content: space-between; }
.section-title { color: #102033; font-size: 32rpx; font-weight: 700; }
.section-note { color: #9aa6b4; font-size: 22rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.quick-card { padding: 26rpx 24rpx; display: flex; flex-direction: column; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 22rpx rgba(27,53,82,.05); }
.quick-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 30rpx; font-weight: 700; }
.progress-icon { background: #e5f4ff; color: #1677c8; }
.user-icon { background: #e8f8f1; color: #169b67; }
.quick-title { margin-top: 18rpx; color: #1b2b3e; font-size: 28rpx; font-weight: 600; }
.quick-desc { margin-top: 8rpx; color: #8794a5; font-size: 21rpx; line-height: 1.45; }
.notice-card { margin-top: 24rpx; padding: 24rpx; display: flex; align-items: flex-start; border: 1rpx solid #dcecf7; border-radius: 20rpx; background: #f7fcff; }
.notice-icon { width: 38rpx; height: 38rpx; margin-right: 18rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #dff1fb; color: #1677c8; font-size: 23rpx; font-weight: 700; }
.notice-copy { display: flex; flex-direction: column; }
.notice-title { color: #35506b; font-size: 25rpx; font-weight: 600; }
.notice-text { margin-top: 6rpx; color: #77879a; font-size: 22rpx; line-height: 1.5; }

.page { min-height: 100vh; padding: 28rpx 28rpx 50rpx; box-sizing: border-box; background: #f4f7fb; }
.status-card { padding: 34rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 28rpx; background: linear-gradient(135deg,#1677c8,#55b9e9); color: #fff; box-shadow: 0 12rpx 30rpx rgba(22,119,200,.18); }.eyebrow { display: block; font-size: 22rpx; opacity: .86; }.status-title { display: block; margin-top: 8rpx; font-size: 38rpx; font-weight: 700; }.status-desc { display: block; max-width: 480rpx; margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; opacity: .9; }.status-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.2); font-size: 36rpx; }
.lock-tip { margin-top: 20rpx; padding: 20rpx; display: flex; align-items: flex-start; border: 1rpx solid #cfe5f2; border-radius: 16rpx; background: #eef8fd; color: #61788e; font-size: 22rpx; line-height: 1.55; }.lock-icon { margin-right: 14rpx; flex: none; color: #1677c8; font-weight: 700; }
.detail-card { margin-top: 20rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 22rpx rgba(27,53,82,.05); }.card-title { padding-bottom: 20rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; color: #1d3045; font-size: 29rpx; font-weight: 700; }.step { color: #c9d4df; font-size: 25rpx; }.detail-row { min-height: 78rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f0f2f5; }.detail-row:last-child { border-bottom: 0; }.label { color: #7b899a; font-size: 24rpx; }.value { color: #34495f; font-size: 24rpx; font-weight: 600; }.highlight { color: #1677c8; }
.commitment-row { min-height: 70rpx; display: flex; align-items: center; color: #53667a; font-size: 24rpx; }.check { width: 34rpx; height: 34rpx; margin-right: 15rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; background: #fdecec; color: #d14343; font-size: 20rpx; }.check.accepted { background: #e7f7ef; color: #168960; }
.meta-card { margin-top: 20rpx; padding: 18rpx 28rpx; border-radius: 20rpx; background: #fff; }.meta-card view { min-height: 64rpx; display: flex; align-items: center; justify-content: space-between; color: #97a3b1; font-size: 21rpx; }.meta-card view text:last-child { max-width: 430rpx; color: #66778a; text-align: right; }
.withdraw-button,.reapply-button { margin-top: 26rpx; border-radius: 14rpx; font-size: 27rpx; }.withdraw-button { background: #fff; color: #d14343; }.withdraw-button::after { border-color: #edcaca; }.reapply-button { background: #1677c8; color: #fff; }.reapply-button::after { border: 0; }.withdraw-note,.message { display: block; margin-top: 22rpx; color: #98a4b2; font-size: 22rpx; text-align: center; }.message { color: #b54708; }
.state-card { min-height: 300rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 24rpx; background: #fff; color: #718095; }.loading-ring { width: 54rpx; height: 54rpx; margin-bottom: 20rpx; border: 6rpx solid #dceefa; border-top-color: #1677c8; border-radius: 50%; animation: spin .8s linear infinite; }.state-card.error { color: #b54708; } @keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

@import "../screen/index.wxss";
.question-card{animation:questionIn .24s ease-out}.next-button{width:100%;height:82rpx;margin-top:24rpx;border-radius:14rpx;background:#1677c8;color:#fff;font-size:27rpx;line-height:82rpx}.next-button::after{border:0}.next-button[disabled]{background:#b9c7d4;color:#eef2f5}.answer.reject{color:#a04b4b}.promise-list{padding:8rpx 22rpx;border-radius:16rpx;background:#f4f9fc}.promise-list text{position:relative;padding:18rpx 0 18rpx 38rpx;display:block;border-bottom:1rpx solid #e4ebf1;color:#465b70;font-size:25rpx}.promise-list text:last-child{border-bottom:0}.promise-list text::before{position:absolute;left:0;content:'✓';color:#168960;font-weight:700}.commitment-question{margin-top:28rpx}.state-card{display:flex;flex-direction:column;align-items:center;text-align:center}.state-icon{width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#e8f2fb;color:#1677c8;font-size:38rpx;font-weight:700}.success-icon{background:#e2f6eb;color:#168960}.end-icon{background:#fff0df;color:#c47714}.state-title{margin-top:22rpx;color:#263a4d;font-size:31rpx;font-weight:700}.state-desc{margin-top:12rpx;color:#718195;font-size:23rpx;line-height:1.6}.secondary-button,.plain-button{width:100%;height:80rpx;margin-top:24rpx;border-radius:14rpx;font-size:25rpx;line-height:80rpx}.secondary-button{background:#1677c8;color:#fff}.plain-button{margin-top:14rpx;background:#edf2f6;color:#53677c}@keyframes questionIn{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}

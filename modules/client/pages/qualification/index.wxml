<view class="page">
  <view wx:if="{{!hasMerchantInvite}}" class="access-mask"><view class="access-card"><text class="access-icon">⌁</text><text class="access-title">请先扫描商家二维码</text><text class="access-desc">客户无法自主发起资料申请，请从商家提供的专属二维码进入办理流程。</text></view></view>
  <view class="intro-card">
    <text class="intro-tag">在线申请</text><text class="intro-title">办理资格申请</text><text class="intro-desc">每次回答一个问题，系统将根据您的回答进入下一步。</text>
    <view class="step-overview"><view class="overview-item {{stageNumber>=1?'active':''}}"><text>1</text><text>联系方式</text></view><view class="overview-line"></view><view class="overview-item {{stageNumber>=2?'active':''}}"><text>2</text><text>办理意愿</text></view><view class="overview-line"></view><view class="overview-item {{stageNumber>=3?'active':''}}"><text>3</text><text>话费与承诺</text></view></view>
  </view>
  <view wx:if="{{stage==='phone'}}" class="form-card question-card"><view class="section-head"><view class="step-number">1</view><view><text class="section-title">请输入本人手机号</text><text class="section-desc">输入完成后将自动查询号码归属地</text></view></view><input class="phone-input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入 11 位手机号" bindinput="onPhoneInput"/><button class="next-button" loading="{{attributionLoading}}" disabled="{{attributionLoading || phone.length != 11}}" bindtap="queryAttribution">{{attributionLoading?'正在查询':'查询归属地'}}</button></view>
  <view wx:if="{{stage==='local'}}" class="form-card question-card"><view class="section-head"><view class="step-number">1</view><view><text class="section-title">确认号码归属</text><text class="section-desc">{{attributionMessage}}</text></view></view><text wx:if="{{attributionLocation}}" class="location">查询结果：{{attributionLocation}}</text><text class="question-title">该手机号是否为本地号码？</text><view class="answer-row"><view class="answer" data-value="YES" bindtap="chooseLocalNumber">本地号码</view><view class="answer" data-value="NO" bindtap="chooseLocalNumber">非本地号码</view></view></view>
  <view wx:if="{{stage==='local-card'}}" class="form-card question-card"><view class="section-head"><view class="step-number">2</view><view><text class="section-title">本地号码办理意愿</text><text class="section-desc">当前号码为非本地号码</text></view></view><text class="question-title">是否同意注册本地号码？</text><view class="answer-row"><view class="answer" data-value="YES" bindtap="chooseAcceptLocalCard">同意</view><view class="answer reject" data-value="NO" bindtap="chooseAcceptLocalCard">不同意</view></view></view>
  <view wx:if="{{stage==='tier'}}" class="form-card question-card"><view class="section-head"><view class="step-number">2</view><view><text class="section-title">选择套餐档位</text><text class="section-desc">{{localNumber==='YES'?'请选择当前套餐额度':'请选择意向套餐额度'}}</text></view></view><view class="tier-list"><view wx:for="{{expenseTiers}}" wx:key="value" class="tier" data-value="{{item.value}}" bindtap="chooseExpenseTier">{{item.label}}</view></view><view class="rule-tip"><text class="tip-icon">i</text><text>返现档位与最终资格，以客服复审和实际活动规则为准。</text></view></view>
  <view wx:if="{{stage==='commitment'}}" class="form-card question-card"><view class="section-head"><view class="step-number">3</view><view><text class="section-title">确认三年履约要求</text><text class="section-desc">请阅读并确认全部要求</text></view></view><view class="promise-list"><text>三年内不销户</text><text>三年内不转网</text><text>三年内不降低套餐</text></view><text class="question-title commitment-question">是否接受以上全部办理要求？</text><view class="answer-row"><view class="answer" data-value="YES" bindtap="chooseCommitment">接受并提交</view><view class="answer reject" data-value="NO" bindtap="chooseCommitment">不接受</view></view></view>
  <view wx:if="{{stage==='submitting'}}" class="form-card state-card"><text class="state-icon">…</text><text class="state-title">正在提交资格申请</text><text class="state-desc">请稍候，不要重复操作。</text></view>
  <view wx:if="{{stage==='success'}}" class="form-card state-card success-card"><text class="state-icon success-icon">✓</text><text class="state-title">提交审核成功</text><text class="state-desc">资料已进入客服复审队列，请在业务进度中查看后续状态。</text><button class="next-button" bindtap="backHome">返回用户端</button></view>
  <view wx:if="{{stage==='end'}}" class="form-card state-card end-card"><text class="state-icon end-icon">!</text><text class="state-title">本次申请已结束</text><text wx:for="{{result.reasons}}" wx:key="*this" class="state-desc">{{item}}</text><button class="secondary-button" bindtap="restart">重新填写</button><button class="plain-button" bindtap="backHome">返回用户端</button></view>
  <view wx:if="{{result && stage!=='end' && stage!=='success'}}" class="result warning"><text wx:for="{{result.reasons}}" wx:key="*this" class="result-text">{{item}}</text></view>
</view>

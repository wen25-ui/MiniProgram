.page { min-height: 100vh; padding: 28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f4f7fb; }
.profile-hero { position: relative; min-height: 220rpx; padding: 36rpx; display: flex; align-items: center; overflow: hidden; box-sizing: border-box; border-radius: 30rpx; background: linear-gradient(135deg,#1677c8,#55b9e9); box-shadow: 0 14rpx 32rpx rgba(22,119,200,.18); color: #fff; }
.profile-hero::after { content: ''; position: absolute; right: -80rpx; bottom: -120rpx; width: 290rpx; height: 290rpx; border-radius: 50%; background: rgba(255,255,255,.1); }
.avatar { position: relative; z-index: 1; width: 112rpx; height: 112rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 5rpx solid rgba(255,255,255,.55); border-radius: 50%; background: rgba(255,255,255,.2); font-size: 42rpx; font-weight: 700; }
.user-info { position: relative; z-index: 1; margin-left: 28rpx; display: flex; flex-direction: column; }.welcome { font-size: 36rpx; font-weight: 700; }.phone { margin-top: 8rpx; font-size: 25rpx; opacity: .9; }.verified { margin-top: 16rpx; display: flex; align-items: center; font-size: 21rpx; opacity: .92; }.verified-dot { width: 28rpx; height: 28rpx; margin-right: 8rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.25); font-size: 18rpx; }
.account-card { position: relative; z-index: 2; margin: -22rpx 18rpx 0; padding: 28rpx 10rpx; display: flex; align-items: center; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(27,53,82,.08); }.account-item { flex: 1; display: flex; flex-direction: column; align-items: center; }.account-value { color: #1f344a; font-size: 25rpx; font-weight: 650; }.account-label { margin-top: 7rpx; color: #99a4b2; font-size: 20rpx; }.divider { width: 1rpx; height: 50rpx; margin: 0; background: #e8edf2; }
.section-title { display: block; margin: 34rpx 6rpx 16rpx; color: #17283c; font-size: 31rpx; font-weight: 700; }
.menu-card { padding: 0 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(27,53,82,.05); }.menu-row { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; }.menu-row:last-child { border-bottom: 0; }.menu-left { display: flex; align-items: center; }.menu-icon { width: 62rpx; height: 62rpx; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 24rpx; font-weight: 700; }.security { background: #e5f4ff; color: #1677c8; }.notice { background: #fff3df; color: #d78512; }.agreement { background: #e8f8f1; color: #169b67; }.help { background: #f1ebff; color: #7856bd; }.menu-title { display: block; color: #26374b; font-size: 27rpx; font-weight: 600; }.menu-desc { display: block; margin-top: 5rpx; color: #99a4b2; font-size: 20rpx; }.arrow { color: #a4afbc; font-size: 42rpx; }
.logout { margin-top: 30rpx; border-radius: 14rpx; background: #fff; color: #d14343; font-size: 27rpx; }.logout::after { border-color: #e3e8ee; }.version { display: block; margin-top: 24rpx; color: #a3adba; font-size: 20rpx; text-align: center; }

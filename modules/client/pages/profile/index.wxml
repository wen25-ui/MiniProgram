<view class="page">
  <view class="profile-hero">
    <view class="avatar">用</view>
    <view class="user-info"><text class="welcome">您好，用户</text><text class="phone">{{maskedPhone}}</text><view class="verified"><text class="verified-dot">✓</text><text>手机号已认证</text></view></view>
  </view>

  <view class="account-card">
    <view class="account-item"><text class="account-value">正常</text><text class="account-label">账户状态</text></view>
    <view class="divider"></view>
    <view class="account-item"><text class="account-value">已认证</text><text class="account-label">实名认证</text></view>
    <view class="divider"></view>
    <view class="account-item"><text class="account-value">用户端</text><text class="account-label">当前身份</text></view>
  </view>

  <text class="section-title">账户服务</text>
  <view class="menu-card">
    <view class="menu-row" data-name="账户与安全" bindtap="showPending"><view class="menu-left"><view class="menu-icon security">盾</view><view><text class="menu-title">账户与安全</text><text class="menu-desc">密码、手机号与登录设备</text></view></view><text class="arrow">›</text></view>
    <view class="menu-row" data-name="消息通知" bindtap="showPending"><view class="menu-left"><view class="menu-icon notice">铃</view><view><text class="menu-title">消息通知</text><text class="menu-desc">审核、预约与办理提醒</text></view></view><text class="arrow">›</text></view>
    <view class="menu-row" data-name="服务协议" bindtap="showPending"><view class="menu-left"><view class="menu-icon agreement">文</view><view><text class="menu-title">服务协议</text><text class="menu-desc">用户协议与隐私政策</text></view></view><text class="arrow">›</text></view>
    <view class="menu-row" data-name="帮助与反馈" bindtap="showPending"><view class="menu-left"><view class="menu-icon help">?</view><view><text class="menu-title">帮助与反馈</text><text class="menu-desc">常见问题与意见反馈</text></view></view><text class="arrow">›</text></view>
  </view>

  <button class="logout" bindtap="logout">退出当前账户</button>
  <text class="version">业务返现管理 · 用户端</text>
  <client-bottom-nav current="profile"></client-bottom-nav>
</view>

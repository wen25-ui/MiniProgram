<view class="page"><view class="hero"><view><text class="eyebrow">财务工作台</text><text class="hero-title">账务与结算中心</text><text class="hero-desc">纸面账单、返现入账与佣金对账</text></view><view class="hero-icon">¥</view></view><text wx:if="{{message}}" class="message">{{message}}</text><view class="money-card"><view><text>返现账面总额</text><text class="money">¥{{stats.cashback_total || 0}}</text></view><view class="money-divider"></view><view><text>佣金账面总额</text><text class="money commission">¥{{stats.commission_total || 0}}</text></view></view><view class="stats"><view><text class="value">{{stats.total_bills || 0}}</text><text>账单总数</text></view><view><text class="value blue">{{stats.pending_confirmation || 0}}</text><text>待确认</text></view><view><text class="value green">{{stats.completed_applications || 0}}</text><text>完成业务</text></view></view><view class="action-card" bindtap="goBills"><view class="action-icon">账</view><view class="action-main"><text>纸面账单管理</text><text>查看返现、佣金及入账状态</text></view><text class="arrow">›</text></view><view class="section-head"><text>最近账单</text><text bindtap="goBills">查看全部 ›</text></view><view wx:if="{{bills.length}}" class="bill-list"><view wx:for="{{bills}}" wx:key="id" class="bill-row"><view><text class="bill-no">{{item.bill_number}}</text><text class="merchant">{{item.merchant_name || '未关联门店'}}</text></view><view class="bill-side"><text class="amount">¥{{item.cashback_amount || 0}}</text><text class="status">{{item.status}}</text></view></view></view><view wx:else class="empty">暂无纸面账单记录</view><role-bottom-nav role="finance" current="home"></role-bottom-nav></view>

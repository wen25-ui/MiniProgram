.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:36rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#3756c7,#7186e8);color:#fff;box-shadow:0 14rpx 32rpx rgba(55,86,199,.2)}.eyebrow{display:block;font-size:23rpx;opacity:.86}.hero-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.hero-desc{display:block;margin-top:12rpx;font-size:22rpx;opacity:.86}.hero-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:42rpx;font-weight:700}.message{display:block;margin-top:18rpx;color:#b54708}.money-card{margin-top:22rpx;padding:30rpx;display:flex;border-radius:24rpx;background:#fff}.money-card>view{flex:1;display:flex;flex-direction:column;color:#8d98a7;font-size:21rpx}.money{margin-top:10rpx;color:#3756c7;font-size:36rpx;font-weight:700}.money.commission{color:#d27a12}.money-divider{max-width:1rpx;margin:0 24rpx;background:#e7ebf0}.stats{margin-top:18rpx;padding:25rpx 10rpx;display:flex;border-radius:22rpx;background:#fff}.stats view{flex:1;display:flex;flex-direction:column;align-items:center;color:#929daa;font-size:20rpx}.value{margin-bottom:7rpx;color:#26384c;font-size:32rpx;font-weight:700}.value.blue{color:#3756c7}.value.green{color:#168960}.action-card{margin-top:20rpx;padding:26rpx;display:flex;align-items:center;border-radius:22rpx;background:#fff}.action-icon{width:66rpx;height:66rpx;margin-right:18rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#eef0ff;color:#3756c7;font-weight:700}.action-main{flex:1}.action-main text:first-child{display:block;color:#2d3f54;font-size:27rpx;font-weight:600}.action-main text:last-child{display:block;margin-top:5rpx;color:#98a3b1;font-size:20rpx}.arrow{color:#a0aab7;font-size:40rpx}.section-head{margin:32rpx 6rpx 16rpx;display:flex;justify-content:space-between}.section-head text:first-child{font-size:31rpx;font-weight:700}.section-head text:last-child{color:#3756c7;font-size:22rpx}.bill-list{padding:0 26rpx;border-radius:24rpx;background:#fff}.bill-row{min-height:104rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #edf0f4}.bill-row:last-child{border-bottom:0}.bill-no{display:block;color:#33465b;font-size:24rpx;font-weight:600}.merchant{display:block;margin-top:5rpx;color:#9aa5b2;font-size:19rpx}.bill-side{text-align:right}.amount{display:block;color:#d27a12;font-size:25rpx;font-weight:700}.status{display:block;margin-top:5rpx;color:#77879a;font-size:18rpx}.empty{padding:70rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

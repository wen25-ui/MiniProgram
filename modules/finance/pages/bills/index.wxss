.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#3756c7,#7186e8);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.message{display:block;margin-top:18rpx;color:#b54708}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.head{display:flex;justify-content:space-between}.bill-no{display:block;color:#2d4055;font-size:27rpx;font-weight:700}.merchant{display:block;margin-top:5rpx;color:#929eac;font-size:20rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#eef0ff;color:#3756c7;font-size:21rpx}.amount-row{margin:22rpx 0;padding:22rpx;display:flex;border-radius:16rpx;background:#f7f8fc}.amount-row view{flex:1;display:flex;flex-direction:column;color:#8c98a7;font-size:20rpx}.amount-row view text:last-child{margin-top:7rpx;color:#d27a12;font-size:29rpx;font-weight:700}.row{min-height:62rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #edf0f4;color:#8a96a5;font-size:21rpx}.row text:last-child{max-width:430rpx;color:#475a70;text-align:right}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

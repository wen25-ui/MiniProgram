.page{min-height:100vh;padding:28rpx 28rpx 50rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#168960,#50b88a);color:#fff}.eyebrow{font-size:22rpx;opacity:.86}.title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.card-title{padding-bottom:20rpx;border-bottom:1rpx solid #edf0f4;color:#1d3045;font-size:29rpx;font-weight:700}.row{min-height:76rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#7b899a;font-size:23rpx}.row text:last-child{max-width:440rpx;color:#34495f;font-weight:600;text-align:right}.row text.small{font-size:18rpx}.row text.success{color:#168960}.voucher{margin-top:20rpx;padding:20rpx;border-radius:14rpx;background:#f4f9f6}.voucher text{display:block;color:#77879a;font-size:22rpx}.voucher text:last-child{margin-top:12rpx;color:#34495f;font-size:24rpx;line-height:1.6}.confirm{margin-top:20rpx;padding:20rpx;display:flex;align-items:center;border-radius:14rpx;background:#f4f9f6;color:#355c4a;font-size:24rpx}.checkbox{width:38rpx;height:38rpx;margin-right:14rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #9ab4a6;border-radius:9rpx}.checkbox.checked{border-color:#168960;background:#168960;color:#fff}.reason{min-height:140rpx;margin-top:16rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:14rpx;box-sizing:border-box;background:#fafcfa;font-size:23rpx}.approve,.return{height:82rpx;border-radius:14rpx;font-size:26rpx;line-height:82rpx}.approve{margin-top:20rpx;background:#168960;color:#fff}.return{margin-top:14rpx;background:#fff0f0;color:#d14343}.approve::after,.return::after{border:0}.state{padding:100rpx 20rpx;border-radius:24rpx;background:#fff;color:#718095;text-align:center}.state.error,.message{color:#b54708}.message{display:block;margin-top:18rpx;text-align:center}

<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取订单核销资料…</view>
  <view wx:elif="{{message&&!verification}}" class="state error">{{message}}</view>
  <block wx:elif="{{verification}}">
    <view class="header"><text class="eyebrow">订单核销</text><text class="title">核实办理结果</text><text class="desc">请核对业务员提交资料，并与客户确认是否办理完成</text></view>
    <view class="card"><view class="card-title">订单信息</view><view class="row"><text>客户手机号</text><text>{{verification.phone}}</text></view><view class="row"><text>订单编号</text><text class="small">{{verification.id}}</text></view><view class="row"><text>办理方式</text><text>{{verification.serviceMode==='HOME_SERVICE'?'上门办理':'指定网点办理'}}</text></view><view wx:if="{{verification.outletName}}" class="row"><text>办理网点</text><text>{{verification.outletName}}</text></view><view class="row"><text>套餐档位</text><text>{{verification.expenseText}}</text></view></view>
    <view class="card"><view class="card-title">业务员提交信息</view><view class="row"><text>办理人员</text><text>{{verification.salesmanName}}</text></view><view class="row"><text>业务员工号</text><text>{{verification.salesmanCode || '未填写'}}</text></view><view class="row"><text>人员类型</text><text>{{verification.salesmanType==='BRANCH'?'网点型':'上门型'}}</text></view><view class="row"><text>实名核实</text><text class="success">{{verification.identityVerified?'已核实':'未核实'}}</text></view><view class="voucher"><text>业务办理及凭证说明</text><text>{{verification.voucherRemark}}</text></view><view class="row"><text>提交时间</text><text>{{verification.submittedAt}}</text></view></view>
    <view class="card"><view class="card-title">客户确认</view><view class="confirm" bindtap="toggleCustomerConfirmed"><view class="checkbox {{customerConfirmed?'checked':''}}">{{customerConfirmed?'✓':''}}</view><text>已与客户确认业务办理完成</text></view><textarea class="reason" value="{{returnReason}}" placeholder="如资料不完整或客户未确认，请填写退回原因" bindinput="onReasonInput"/><button class="approve" disabled="{{submitting||!customerConfirmed}}" loading="{{submitting}}" bindtap="approve">确认办理完成并核销</button><button class="return" disabled="{{submitting}}" bindtap="returnForUpdate">退回业务员补充</button></view>
    <text wx:if="{{message}}" class="message">{{message}}</text>
  </block>
</view>

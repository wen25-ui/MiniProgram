.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.filters{margin:20rpx 0;padding:7rpx;display:flex;border-radius:16rpx;background:#fff}.filter{flex:1;padding:16rpx;border-radius:12rpx;color:#7c8998;font-size:22rpx;text-align:center}.filter.active{background:#e7f7f5;color:#0f7f89;font-weight:700}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.05)}.head{display:flex;align-items:flex-start;justify-content:space-between}.customer{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.outlet{display:block;margin-top:7rpx;color:#8694a5;font-size:21rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7f5;color:#0f7f89;font-size:21rpx}.row{min-height:62rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#8a96a5;font-size:21rpx}.row text:last-child{color:#475a70}.entry{margin-top:18rpx;display:flex;justify-content:space-between;color:#0f7f89;font-size:23rpx}.message{display:block;margin-bottom:16rpx;color:#b54708}.empty{padding:80rpx 20rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

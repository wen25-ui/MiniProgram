<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取业务详情…</view>
  <view wx:elif="{{message}}" class="state error">{{message}}</view>
  <block wx:elif="{{application}}">
    <view class="header"><text class="eyebrow">当前业务状态</text><text class="title">{{application.statusText}}</text><text class="desc">{{application.statusDescription}}</text><text class="id">{{application.id}}</text></view>
    <view class="card"><view class="card-title">客户与申请</view><view class="row"><text>客户手机号</text><text>{{application.phone}}</text></view><view class="row"><text>来源商家</text><text>{{application.sourceMerchantName||'未关联'}}</text></view><view class="row"><text>商家联系人</text><text>{{application.merchantContactName||'未填写'}} {{application.merchantContactPhone}}</text></view><view class="row"><text>套餐档位</text><text>{{application.expenseText}}</text></view><view class="row"><text>创建时间</text><text>{{application.createdAt}}</text></view><view class="row"><text>最近更新</text><text>{{application.updatedAt}}</text></view></view>
    <view class="card"><view class="card-title">审核信息</view><view class="row"><text>联系结果</text><text>{{application.contactResult==='CONTACTED'?'已联系':application.contactResult==='UNREACHABLE'?'未联系成功':application.contactResult==='CLIENT_DECLINED'?'客户拒绝':'待联系'}}</text></view><view class="row"><text>真实性结果</text><text>{{application.verifyResult==='VERIFIED'?'信息属实':application.verifyResult==='INVALID_INFO'?'信息异常':'待核实'}}</text></view><view class="row"><text>客户意愿</text><text>{{application.customerIntention==='WILLING'?'愿意办理':application.customerIntention==='UNWILLING'?'不办理':'待确认'}}</text></view><view wx:if="{{application.verificationRemark}}" class="remark"><text>核实说明</text><text>{{application.verificationRemark}}</text></view><view wx:if="{{application.contactReason}}" class="remark"><text>联系说明</text><text>{{application.contactReason}}</text></view><block wx:if="{{application.correctedInfo}}"><view class="row"><text>修正后号码类型</text><text>{{application.correctedInfo.localNumber?'本地号码':'非本地号码（接受本地卡）'}}</text></view><view class="row"><text>修正后套餐档位</text><text>{{application.expenseText}}</text></view><view wx:if="{{application.correctedInfo.remark}}" class="remark"><text>修正备注</text><text>{{application.correctedInfo.remark}}</text></view></block></view>
    <view class="card"><view class="card-title">办理与派单</view><view class="row"><text>办理方式</text><text>{{application.serviceMode==='HOME_SERVICE'?'上门办理':application.serviceMode==='STORE_SERVICE'?'线下网点办理':'待确认'}}</text></view><view class="row"><text>指定网点</text><text>{{application.assignedStoreName||'未分配'}}</text></view><view class="row"><text>办理人员</text><text>{{application.handlerName||'未分配'}}</text></view><view wx:if="{{application.salesmanCode}}" class="row"><text>业务员工号</text><text>{{application.salesmanCode}}</text></view><view class="row"><text>预约时间</text><text>{{application.appointmentTime||'未设置'}}</text></view></view>
    <view wx:if="{{application.fulfillment}}" class="card"><view class="card-title">办理结果与核销</view><view class="row"><text>实名核实</text><text>{{application.fulfillment.identityVerified?'已核实':'未核实'}}</text></view><view class="remark"><text>凭证说明</text><text>{{application.fulfillment.voucherRemark}}</text></view><view class="row"><text>核销状态</text><text>{{application.fulfillment.verificationStatus}}</text></view><view wx:if="{{application.fulfillment.verificationReason}}" class="remark"><text>核销说明</text><text>{{application.fulfillment.verificationReason}}</text></view><view class="row"><text>提交时间</text><text>{{application.fulfillment.submittedAt}}</text></view></view>
    <view class="card"><view class="card-title">状态流转记录</view><view wx:for="{{application.history}}" wx:key="id" class="timeline"><view class="dot"></view><view class="timeline-content"><text class="change">{{item.fromStatusText}} → {{item.toStatusText}}</text><text class="action">{{item.actionCode}}</text><text wx:if="{{item.reason}}" class="reason">{{item.reason}}</text><text class="operator">{{item.operatorName}}（{{item.operatorRole}}） · {{item.createdAt}}</text></view></view><view wx:if="{{!application.history.length}}" class="empty">暂无状态流转记录</view></view>
  </block>
</view>

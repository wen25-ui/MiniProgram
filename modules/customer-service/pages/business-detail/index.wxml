<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取项目详情…</view>
  <view wx:elif="{{message}}" class="state error">{{message}}</view>
  <block wx:elif="{{application}}">
    <view class="header"><text class="eyebrow">项目当前状态</text><text class="title">{{application.currentProcessingStatus}}</text><text class="desc">{{application.statusDescription}}</text><text class="id">{{application.id}}</text></view>

    <view class="card"><view class="card-title">客户信息</view><view class="row"><text>客户</text><text>{{application.customerName}}</text></view><view class="row"><text>手机号</text><text>{{application.phone}}</text></view><view class="row"><text>来源项目</text><text>{{application.sourceMerchantName || '业务返现办理'}}</text></view><view class="row"><text>客户地址</text><text>{{application.province}} {{application.city}} {{application.district}} {{application.detailAddress}}</text></view><view class="row"><text>最近更新</text><text>{{application.updatedAt}}</text></view></view>

    <view class="card"><view class="card-title">审核记录</view><view class="row"><text>联系结果</text><text>{{application.contactResult === 'CONTACTED' ? '已联系' : application.contactResult === 'UNREACHABLE' ? '待重联' : '待确认'}}</text></view><view class="row"><text>信息核实</text><text>{{application.verifyResult === 'VERIFIED' ? '已确认' : application.verifyResult === 'INVALID_INFO' ? '信息异常' : '待确认'}}</text></view><view wx:if="{{application.verificationRemark}}" class="remark"><text>审核说明</text><text>{{application.verificationRemark}}</text></view><view wx:if="{{application.contactReason}}" class="remark"><text>联系说明</text><text>{{application.contactReason}}</text></view></view>

    <view class="card"><view class="card-title">派遣与业务员进度</view><view class="row"><text>派遣网点</text><text>{{application.branchName}}</text></view><view class="row"><text>当前业务员</text><text>{{application.salesmanName}}</text></view><view class="row"><text>办理方式</text><text>{{application.serviceMode === 'HOME_SERVICE' ? '上门办理' : application.serviceMode === 'STORE_SERVICE' ? '到店办理' : '待确认'}}</text></view><view class="row"><text>当前进度</text><text>{{application.currentProcessingStatus}}</text></view></view>

    <view class="card"><view class="card-title">流程时间轴</view><view wx:for="{{stages}}" wx:key="key" class="stage {{item.active ? 'active' : ''}}"><view class="stage-dot"></view><view><text>{{item.title}}</text><text>{{item.time || (item.active ? '已进入该阶段' : '尚未进入')}}</text></view></view></view>

    <view class="card"><view class="card-title">详细流转记录</view><view wx:for="{{application.history}}" wx:key="id" class="timeline"><view class="dot"></view><view class="timeline-content"><text class="change">{{item.fromStatusText}} → {{item.toStatusText}}</text><text class="action">{{item.actionCode}}</text><text wx:if="{{item.reason}}" class="reason">{{item.reason}}</text><text class="operator">{{item.operatorName}} · {{item.createdAt}}</text></view></view><view wx:if="{{!application.history.length}}" class="empty">暂无流转记录</view></view>

    <view class="actions"><button bindtap="urge">催办</button><button class="warn" bindtap="reassign">异常重新派遣</button></view>
    <text class="todo-tip">催办和异常重新派遣入口已保留，提交接口待后端补充。</text>
  </block>
</view>

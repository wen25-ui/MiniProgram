.page{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.eyebrow{font-size:21rpx;opacity:.86}.title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.id{display:block;margin-top:12rpx;font-size:18rpx;opacity:.75}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.card-title{padding-bottom:18rpx;border-bottom:1rpx solid #edf1f4;color:#25394f;font-size:28rpx;font-weight:700}.row{min-height:70rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#7c8998;font-size:22rpx}.row text:last-child{max-width:430rpx;color:#40546a;text-align:right}.remark{margin-top:16rpx;padding:18rpx;border-radius:14rpx;background:#f5f9fa}.remark text{display:block;color:#7c8998;font-size:21rpx}.remark text:last-child{margin-top:8rpx;color:#40546a;font-size:23rpx;line-height:1.55}.timeline{position:relative;padding:22rpx 0 22rpx 34rpx;border-left:2rpx solid #d8ebe9}.dot{position:absolute;left:-9rpx;top:29rpx;width:16rpx;height:16rpx;border-radius:50%;background:#0f8d93}.timeline-content text{display:block}.change{color:#30475e;font-size:23rpx;font-weight:700}.action{margin-top:7rpx;color:#0f7f89;font-size:20rpx}.reason{margin-top:6rpx;color:#66788b;font-size:21rpx}.operator{margin-top:7rpx;color:#98a4b1;font-size:19rpx}.state,.empty{padding:90rpx 20rpx;border-radius:24rpx;background:#fff;color:#8b98a7;text-align:center}.state.error{color:#b54708}
.stage{position:relative;padding:20rpx 0 20rpx 38rpx;border-left:3rpx solid #e2e8ee;color:#9aa5b2}.stage-dot{position:absolute;left:-10rpx;top:28rpx;width:17rpx;height:17rpx;border-radius:50%;background:#d4dce4}.stage text{display:block;font-size:23rpx}.stage text:last-child{margin-top:7rpx;font-size:19rpx}.stage.active{border-left-color:#8dd1ca;color:#30475e}.stage.active .stage-dot{background:#0f8d93}.actions{margin-top:20rpx;display:flex;gap:14rpx}.actions button{flex:1;margin:0;border-radius:14rpx;background:#e7f7f5;color:#0f7f89;font-size:23rpx}.actions .warn{background:#fff1f0;color:#d14343}.todo-tip{display:block;margin-top:14rpx;color:#98a4b1;font-size:19rpx;text-align:center}

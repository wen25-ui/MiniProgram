<view class="page">
  <view class="hero">
    <view><text class="eyebrow">客服工作台</text><text class="hero-title">审核、派店与项目跟进</text><text class="hero-desc">联系客户并完善信息后，将订单指派到办理网点</text></view>
    <view class="hero-icon">客</view>
  </view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view class="stats-grid">
    <view class="stat-card" data-status="WAIT_REVIEW" bindtap="goReview"><view class="dot review"></view><text class="value">{{stats.waitReview}}</text><text>待审核</text></view>
    <view class="stat-card" data-status="WAIT_RECONTACT" bindtap="goReview"><view class="dot recontact"></view><text class="value">{{stats.waitRecontact}}</text><text>待重联</text></view>
    <view class="stat-card" data-status="PROCESSING" bindtap="goFollowUp"><view class="dot following"></view><text class="value">{{stats.following}}</text><text>跟进中</text></view>
    <view class="stat-card" data-status="FINISHED" bindtap="goFollowUp"><view class="dot completed"></view><text class="value">{{stats.completed}}</text><text>完成任务</text></view>
  </view>
  <view class="quick-actions"><button bindtap="goReview">审核派遣</button><button bindtap="goFollowUp">项目跟进</button></view>
  <view class="section-head"><text>最近业务</text></view>
  <view wx:if="{{recent.length}}" class="list">
    <view wx:for="{{recent}}" wx:key="id" class="row"><view class="avatar">{{index + 1}}</view><view class="main"><text>{{item.customerName || item.maskedPhone || '未填写'}}</text><text>{{item.updatedAt || item.submittedAt || '未记录更新时间'}}</text></view><text class="status">{{item.statusText}}</text></view>
  </view>
  <view wx:else class="empty">{{loading ? '正在读取工作台…' : '当前没有客服待办事项'}}</view>
  <role-bottom-nav role="customer-service" current="home"></role-bottom-nav>
</view>

<view class="page">
  <view class="hero"><view><text class="eyebrow">客服工作台</text><text class="hero-title">我的客服任务</text><text class="hero-desc">处理系统分配给我的客户审核与网点派遣任务</text></view><view class="hero-icon">任</view></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view class="section-head"><text>我的任务</text></view>
  <view class="stats-grid">
    <view class="stat-card" data-status="ASSIGNED" bindtap="goTasks"><view class="dot review"></view><text class="value">{{stats.waitContact}}</text><text>待联系</text></view>
    <view class="stat-card" data-status="PROCESSING" bindtap="goTasks"><view class="dot following"></view><text class="value">{{stats.processing}}</text><text>处理中</text></view>
    <view class="stat-card" data-status="WAIT_DISPATCH" bindtap="goTasks"><view class="dot dispatch"></view><text class="value">{{stats.waitDispatch}}</text><text>待派遣</text></view>
  </view>
  <view class="section-head"><text>异常提醒</text></view>
  <view class="stat-card warning-card" data-status="TIMEOUT" bindtap="goTasks"><view class="dot recontact"></view><text class="value">{{stats.timeout}}</text><text>超时任务</text></view>
  <view class="section-head"><text>今日完成</text></view>
  <view class="stat-card completed-card"><view class="dot completed"></view><text class="value">{{stats.todayCompleted}}</text><text>今日完成任务</text></view>
  <view wx:if="{{statisticsUnavailable}}" class="empty">客服任务统计接口待接入，当前暂无个人任务统计。<!-- TODO: GET /customer-service/tasks/statistics --></view>
  <view class="quick-actions"><button bindtap="goTasks">我的审核任务</button><button bindtap="goFollowUp">项目跟进</button></view>
  <role-bottom-nav role="customer-service" current="home"></role-bottom-nav>
</view>

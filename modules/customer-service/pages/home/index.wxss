.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.hero{padding:36rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff;box-shadow:0 14rpx 32rpx rgba(15,127,137,.18)}.eyebrow{display:block;font-size:23rpx;opacity:.86}.hero-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.hero-desc{display:block;margin-top:12rpx;font-size:22rpx;opacity:.86}.hero-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:35rpx;font-weight:700}.message{display:block;margin-top:18rpx;color:#b54708}.stats-grid{margin-top:22rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.stat-card{position:relative;padding:25rpx;border-radius:22rpx;background:#fff}.dot{position:absolute;right:22rpx;top:22rpx;width:14rpx;height:14rpx;border-radius:50%}.review{background:#d78012}.recontact{background:#d65b62}.following{background:#1677c8}.completed{background:#168960}.value{display:block;color:#26384c;font-size:38rpx;font-weight:700}.stat-card>text:last-child{display:block;margin-top:7rpx;color:#8b97a6;font-size:21rpx}.quick-actions{margin-top:22rpx;display:flex;gap:16rpx}.quick-actions button{flex:1;margin:0;border-radius:14rpx;background:#0f7f89;color:#fff;font-size:24rpx}.quick-actions button:last-child{background:#16777f}.quick-actions button::after{border:0}.section-head{margin:32rpx 6rpx 16rpx}.section-head text{font-size:31rpx;font-weight:700}.list{padding:0 25rpx;border-radius:24rpx;background:#fff}.row{min-height:104rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.row:last-child{border-bottom:0}.avatar{width:52rpx;height:52rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#e7f7f5;color:#0f7f89}.main{min-width:0;flex:1}.main text:first-child{display:block;color:#314459;font-size:24rpx;font-weight:600}.main text:last-child{display:block;margin-top:4rpx;color:#a0aab7;font-size:18rpx}.status{color:#0f7f89;font-size:21rpx}.empty{padding:70rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff;box-shadow:0 12rpx 30rpx rgba(15,127,137,.16)}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.summary-bar{margin:20rpx 0;display:flex;align-items:center;justify-content:space-between;color:#718095;font-size:21rpx}.summary-bar view{display:flex;align-items:baseline}.summary-count{margin-right:8rpx;color:#0f7f89;font-size:34rpx;font-weight:700}.summary-note{color:#98a3b1}.message{display:block;margin-bottom:16rpx;padding:16rpx;border-radius:12rpx;background:#fff5e8;color:#b54708;font-size:22rpx}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.06)}.head{display:flex;align-items:flex-start;justify-content:space-between}.phone{display:block;color:#2d4156;font-size:29rpx;font-weight:700}.merchant{display:block;margin-top:7rpx;color:#8694a5;font-size:21rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7f5;color:#0f7f89;font-size:21rpx}.meta{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#98a3b1;font-size:20rpx}.meta text:last-child{max-width:450rpx;color:#607286;text-align:right}.detail-entry{margin-top:18rpx;padding-top:18rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #edf1f4;color:#0f7f89;font-size:24rpx;font-weight:600}.detail-entry text:last-child{font-size:38rpx;font-weight:400}.state-card,.empty{min-height:260rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:24rpx;background:#fff;color:#8491a1;font-size:24rpx}.loading-ring{width:48rpx;height:48rpx;margin-bottom:20rpx;border:6rpx solid #dcefed;border-top-color:#0f7f89;border-radius:50%;animation:spin .8s linear infinite}.empty-icon{width:70rpx;height:70rpx;margin-bottom:18rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#e7f7ef;color:#168960;font-size:34rpx}@keyframes spin{to{transform:rotate(360deg)}}
.filters{margin:-4rpx 0 20rpx;white-space:nowrap}.filter-row{display:flex;gap:12rpx}.filter{padding:14rpx 22rpx;border-radius:28rpx;background:#fff;color:#718095;font-size:21rpx}.filter.active{background:#0f8d93;color:#fff;font-weight:700}.recontact-card{border:2rpx solid #f0c8a6}.contact-flag{margin-top:16rpx;padding:16rpx;border-radius:12rpx;background:#fff5e8}.contact-flag text{display:block;color:#b56018;font-size:21rpx}.contact-flag text:first-child{font-weight:700}.contact-flag text:last-child{margin-top:6rpx;color:#8c735f}

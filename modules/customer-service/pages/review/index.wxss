.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.summary-bar{margin:20rpx 0;display:flex;align-items:center;justify-content:space-between;color:#718095;font-size:21rpx}.summary-count{margin-right:8rpx;color:#0f7f89;font-size:34rpx;font-weight:700}.summary-note{color:#98a3b1}.filters{margin-bottom:20rpx;padding:7rpx;display:flex;border-radius:16rpx;background:#fff}.filter{flex:1;padding:16rpx;border-radius:12rpx;color:#7c8998;font-size:22rpx;text-align:center}.filter.active{background:#e7f7f5;color:#0f7f89;font-weight:700}.message{display:block;margin-bottom:16rpx;padding:16rpx;border-radius:12rpx;background:#fff5e8;color:#b54708}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.06)}.recontact-card{border:2rpx solid #f0c8a6}.head{display:flex;align-items:flex-start;justify-content:space-between}.customer{display:block;color:#2d4156;font-size:29rpx;font-weight:700}.phone{display:block;margin-top:7rpx;color:#8694a5;font-size:21rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7f5;color:#0f7f89;font-size:21rpx}.meta{min-height:62rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#98a3b1;font-size:21rpx}.meta text:last-child{max-width:430rpx;color:#607286;text-align:right}.detail-entry{margin-top:18rpx;display:flex;justify-content:space-between;color:#0f7f89;font-size:24rpx;font-weight:600}.state-card,.empty{min-height:260rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:24rpx;background:#fff;color:#8491a1;font-size:24rpx}.loading-ring{width:48rpx;height:48rpx;margin-bottom:20rpx;border:6rpx solid #dcefed;border-top-color:#0f7f89;border-radius:50%;animation:spin .8s linear infinite}.empty-icon{margin-bottom:18rpx;color:#168960;font-size:34rpx}@keyframes spin{to{transform:rotate(360deg)}}

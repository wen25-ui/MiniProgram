<view class="page">
  <view class="header"><text class="title">我的审核任务</text><text class="desc">仅展示系统分配给当前客服的任务</text></view>
  <view class="summary-bar"><view><text class="summary-count">{{tasks.length}}</text><text>条个人任务</text></view><text class="summary-note">任务状态与订单状态分离</text></view>
  <view class="filters"><view wx:for="{{filters}}" wx:key="key" class="filter {{status === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="chooseFilter">{{item.label}}</view></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="state-card"><view class="loading-ring"></view><text>正在读取我的任务…</text></view>
  <view wx:for="{{tasks}}" wx:key="id" class="card {{item.status === 'TIMEOUT' ? 'recontact-card' : ''}}" data-index="{{index}}" bindtap="openDetail"><view class="head"><view><text class="customer">{{item.customerName}}</text><text class="phone">{{item.maskedPhone}}</text></view><text class="status">{{item.statusText}}</text></view><view class="meta"><text>申请项目</text><text>{{item.projectName}}</text></view><view class="meta"><text>任务更新时间</text><text>{{item.updatedAt || '未记录'}}</text></view><view class="detail-entry"><text>进入任务处理</text><text>›</text></view></view>
  <view wx:if="{{tasksUnavailable}}" class="empty"><text>客服个人任务接口待接入</text><text class="empty-note">当前不会回退为公共审核池。<!-- TODO: GET /customer-service/tasks --></text></view>
  <view wx:elif="{{!loading && !tasks.length}}" class="empty"><text class="empty-icon">✓</text><text>当前分类没有我的任务</text></view>
  <role-bottom-nav role="customer-service" current="review"></role-bottom-nav>
</view>

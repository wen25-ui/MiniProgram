<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取审核资料…</view>
  <view wx:elif="{{message && !application}}" class="state error">{{message}}</view>
  <block wx:elif="{{application}}">
    <view class="header"><text class="eyebrow">审核派遣</text><text class="title">{{application.customerName}}</text><text class="desc">{{application.phone}} · {{application.statusText}}</text></view>
    <text wx:if="{{message}}" class="message">{{message}}</text>
    <task-card task-info="{{taskInfo}}"/>
    <view wx:if="{{taskApiUnavailable}}" class="api-tip">客服任务详情接口待接入。<!-- TODO: GET /customer-service/tasks/:id --></view>

    <view class="card"><text class="card-title">客户基础信息</text><view class="row"><text>客户姓名</text><text>{{application.customerName}}</text></view><view class="row"><text>手机号</text><text>{{application.phone}}</text></view><view class="row"><text>申请项目</text><text>{{application.projectName}}</text></view><view class="row"><text>提交时间</text><text>{{application.submittedAt || '未记录'}}</text></view></view>

    <view wx:if="{{!contacted}}" class="card"><text class="step">联系客户</text><text class="section-note">审核前请先电话联系客户并记录结果。</text><button class="primary" loading="{{submitting}}" bindtap="beginContact">拨打客户电话</button><view wx:if="{{contactStarted}}" class="button-row"><button bindtap="contactSuccess">已联系成功</button><button class="warn" bindtap="showContactFail">暂未联系上</button></view><view wx:if="{{contactFormVisible}}"><textarea class="textarea" placeholder="填写未联系成功原因" bindinput="onContactReasonInput"/><button class="warn full" bindtap="submitContactFail">提交并转待重联</button></view></view>

    <block wx:if="{{contacted}}">
      <view class="question-heading"><text>动态审核问题</text><text>问题会根据上一项答案逐步展开</text></view>
      <question-flow questions="{{questions}}" disabled="{{submitting}}" bind:answer="onQuestionAnswer" bind:progress="onQuestionProgress"/>
      <view wx:if="{{!questions.length}}" class="card api-tip">暂无审核问题配置。<!-- TODO: 后端配置 review_questions 及 options 字段。 --></view>

      <block wx:if="{{reviewComplete}}">
        <view class="card"><text class="card-title">客户内部标签</text><text class="private-tip">仅客服可见，不向客户、商家和网点展示</text><view class="tag-list"><view wx:for="{{presetTags}}" wx:key="label" class="tag {{item.selected ? 'active' : ''}}" data-value="{{item.label}}" bindtap="togglePresetTag">{{item.label}}</view></view><view class="custom-row"><input value="{{customTag}}" maxlength="80" placeholder="新增自定义标签" bindinput="onCustomTagInput"/><button bindtap="addCustomTag">添加</button></view><view wx:if="{{tags.length}}" class="selected-tags"><text wx:for="{{tags}}" wx:key="id">#{{item.tag}} </text></view></view>

        <view class="card"><text class="card-title">客服备注</text><textarea class="textarea" value="{{newNote}}" maxlength="500" placeholder="例如：客户要求下午联系，需要提前确认地址。" bindinput="onNoteInput"/><button class="secondary" loading="{{submitting}}" bindtap="submitNote">新增备注</button><view wx:if="{{notes.length}}" class="note-list"><view wx:for="{{notes}}" wx:key="id" class="note-item"><text>{{item.content}}</text><text>{{item.operatorName || '客服'}} · {{item.createdAt}}</text></view></view></view>

        <view wx:if="{{!assigned}}" class="card"><text class="card-title">指派网点</text><text class="private-tip">{{outletMatchText}} · 当前版本不计算真实距离</text><branch-selector branches="{{outlets}}" selected-id="{{selectedBranchId}}" loading="{{submitting}}" disabled="{{!canAssignBranch}}" bind:select="chooseOutlet" bind:confirm="assignOutlet"/><view wx:if="{{!canAssignBranch}}" class="api-tip">审核答案已填写；订单确认审核完成的接口尚未提供。<!-- TODO: 后端新增审核完成并推进至 WAIT_BRANCH/CONFIRMED 的接口。 --></view></view>
        <view wx:else class="completed-tip">已完成网点指派，订单已进入项目跟进。</view>
      </block>
    </block>
  </block>
</view>

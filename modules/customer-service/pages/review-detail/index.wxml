<view class="page">
  <view wx:if="{{loading}}" class="state-card"><view class="loading-ring"></view><text>正在读取申请详情…</text></view>
  <view wx:elif="{{message&&!application}}" class="state-card error">{{message}}</view>
  <block wx:elif="{{application}}">
    <view class="status-card"><view><text class="eyebrow">审核申请</text><text class="status-title">{{application.statusText}}</text><text class="status-desc">按流程完成联系、核实、意愿确认和办理方式选择</text></view><view class="status-icon">审</view></view>
    <view class="detail-card merchant-card"><view class="card-title">申请与来源</view><view class="detail-row"><text class="label">客户手机号</text><text class="value">{{application.phone}}</text></view><view class="detail-row"><text class="label">申请编号</text><text class="value small">{{application.id}}</text></view><view class="detail-row"><text class="label">来源商家</text><text class="value">{{application.merchant.name || '未关联'}}</text></view></view>
    <view class="detail-card"><view class="card-title">客户提交信息</view><view class="detail-row"><text class="label">号码归属地</text><text class="value">{{application.attributionText}}</text></view><view class="detail-row"><text class="label">是否本地号码</text><text class="value answer">{{application.localNumberText}}</text></view><view wx:if="{{application.localNumber === false}}" class="detail-row"><text class="label">接受办理本地卡</text><text class="value answer">{{application.acceptLocalCardText}}</text></view><view class="detail-row"><text class="label">套餐档位</text><text class="value answer">{{application.expenseText}}</text></view><view class="commitment-title">三年履约承诺</view><view wx:for="{{commitments}}" wx:key="label" class="commitment-row"><text class="check {{item.accepted ? 'accepted' : ''}}">{{item.accepted ? '✓' : '!'}}</text><text>{{item.label}}</text><text class="commitment-value">{{item.accepted ? '已确认' : '未确认'}}</text></view></view>

    <view class="review-card">
      <block wx:if="{{!pendingAction}}">
      <button wx:if="{{application.status==='PENDING'}}" class="approve-button" loading="{{submitting}}" bindtap="openContactActions">开始联系客户</button>
      <block wx:if="{{application.status==='CONTACTING'}}"><view wx:if="{{application.contactResult==='UNREACHABLE'}}" class="recontact-notice"><text class="recontact-title">已标记：上次未联系成功</text><text>{{application.contactReason}}</text><text>请后续再次联系，联系结果会继续保留在记录中。</text></view><button class="contact-button" disabled="{{submitting}}" bindtap="openContactActions">拨打电话或复制号码</button><button class="approve-button" loading="{{submitting}}" bindtap="contacted">{{application.contactResult==='UNREACHABLE'?'已重新联系，开始核实':'已联系，开始核实'}}</button><button class="reject-button" disabled="{{submitting}}" bindtap="unreachable">{{application.contactResult==='UNREACHABLE'?'再次未联系成功':'暂未联系成功'}}</button></block>
      <block wx:if="{{application.status==='VERIFYING'}}"><button class="approve-button" loading="{{submitting}}" bindtap="verifyValid">信息属实</button><button class="reject-button" disabled="{{submitting}}" bindtap="verifyInvalid">信息不属实</button></block>
      <block wx:if="{{application.status==='VERIFIED'&&!application.customerIntention}}"><text class="review-tip">请向客户确认是否仍有办理意愿。</text><button class="approve-button" loading="{{submitting}}" bindtap="willing">愿意办理</button><button class="reject-button" disabled="{{submitting}}" bindtap="unwilling">不办理</button></block>
      <block wx:if="{{application.status==='INVALID_INFO'}}"><text class="review-tip">信息异常时仍需确认客户办理意愿。</text><button class="approve-button" loading="{{submitting}}" bindtap="willing">仍愿意办理</button><button class="reject-button" disabled="{{submitting}}" bindtap="unwilling">不办理</button></block>
      <block wx:if="{{application.status==='CORRECTING'}}">
        <text class="correction-tip">已自动选中客户原始答案，请直接修改需要更正的选项。</text>
        <view class="correction-section"><text class="correction-label">该手机号是否为本地号码？</text><view class="option-row"><view class="option {{correction.localNumber===true?'selected':''}}" data-value="YES" bindtap="chooseCorrectionLocal">本地号码</view><view class="option {{correction.localNumber===false?'selected':''}}" data-value="NO" bindtap="chooseCorrectionLocal">非本地号码</view></view></view>
        <view wx:if="{{correction.localNumber===false}}" class="correction-section"><text class="correction-label">是否接受办理本地卡？</text><view class="option-row"><view class="option {{correction.acceptLocalCard===true?'selected':''}}" data-value="YES" bindtap="chooseCorrectionCard">接受</view><view class="option {{correction.acceptLocalCard===false?'selected':''}}" data-value="NO" bindtap="chooseCorrectionCard">不接受</view></view></view>
        <view class="correction-section"><text class="correction-label">套餐档位</text><view class="tier-options"><view wx:for="{{expenseOptions}}" wx:key="value" class="option tier-option {{correction.expenseTier===item.value?'selected':''}}" data-value="{{item.value}}" bindtap="chooseCorrectionTier">{{item.label}}</view></view></view>
        <view class="correction-section"><text class="correction-label">三年履约承诺</text><view wx:for="{{commitments}}" wx:key="label" class="commitment-option {{correction.commitments[index]?'selected':''}}" data-index="{{index}}" bindtap="toggleCorrectionCommitment"><view class="option-check">{{correction.commitments[index]?'✓':''}}</view><text>{{item.label}}</text></view></view>
        <view class="correction-section"><text class="correction-label">修正备注（选填）</text><textarea class="reason-input" value="{{correction.remark}}" placeholder="补充修正原因、与客户确认情况等" bindinput="onCorrectionRemarkInput"/></view>
        <button class="approve-button" loading="{{submitting}}" bindtap="correctInfo">保存更正并重新确认</button>
      </block>
      <block wx:if="{{application.status==='VERIFIED'&&application.customerIntention==='WILLING'}}"><text class="review-tip">客户已确认愿意办理，请选择办理方式并录入客户行政区域。</text><view style="margin-top:14rpx;display:flex;gap:14rpx"><view class="mode-option {{serviceMode==='HOME_SERVICE'?'selected':''}}" style="flex:1;padding:20rpx;border:2rpx solid {{serviceMode==='HOME_SERVICE'?'#0f8d93':'#e1e7ed'}};border-radius:16rpx" data-mode="HOME_SERVICE" bindtap="chooseServiceMode"><text>上门办理</text></view><view class="mode-option {{serviceMode==='STORE_SERVICE'?'selected':''}}" style="flex:1;padding:20rpx;border:2rpx solid {{serviceMode==='STORE_SERVICE'?'#0f8d93':'#e1e7ed'}};border-radius:16rpx" data-mode="STORE_SERVICE" bindtap="chooseServiceMode"><text>线下网点</text></view></view><input wx:if="{{serviceMode}}" class="reason-input" value="{{province}}" placeholder="省，如：四川省" bindinput="onProvinceInput"/><input wx:if="{{serviceMode}}" class="reason-input" value="{{city}}" placeholder="市，如：成都市" bindinput="onCityInput"/><input wx:if="{{serviceMode}}" class="reason-input" value="{{district}}" placeholder="区县，如：武侯区" bindinput="onDistrictInput"/><textarea wx:if="{{serviceMode}}" class="reason-input" value="{{detailAddress}}" placeholder="客户详细地址" bindinput="onDetailAddressInput"/><button class="approve-button" loading="{{submitting}}" bindtap="confirmServiceType">确认办理方式</button></block>
      <view wx:if="{{application.status==='CONFIRMED'}}" class="review-tip">办理方式已确认，请前往任务派遣中心分配{{application.serviceMode==='HOME_SERVICE'?'工作人员':'办理网点'}}。</view>
      </block>
      <view wx:if="{{pendingAction}}" class="event-form">
        <view class="event-form-head"><view><text class="event-form-title">{{actionTitle}}</text><text class="event-form-tip">此事件需要填写处理说明</text></view><text class="event-form-close" bindtap="cancelActionForm">×</text></view>
        <textarea class="reason-input event-input" value="{{actionRemark}}" placeholder="{{actionPlaceholder}}" bindinput="onActionRemarkInput"/>
        <view class="event-actions"><button class="event-cancel" disabled="{{submitting}}" bindtap="cancelActionForm">取消</button><button class="event-submit" loading="{{submitting}}" bindtap="submitActionForm">确认提交</button></view>
      </view>
    </view>
    <text wx:if="{{message}}" class="message">{{message}}</text>
  </block>
</view>

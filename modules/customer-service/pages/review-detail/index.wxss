.page{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.eyebrow{display:block;font-size:22rpx;opacity:.86}.title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 22rpx rgba(27,53,82,.05)}.card-title,.step{display:block;padding-bottom:18rpx;color:#25394f;font-size:29rpx;font-weight:700}.step{color:#0f7f89}.row{min-height:70rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#7c8998;font-size:22rpx}.row text:last-child{max-width:430rpx;color:#40546a;text-align:right}.options{display:flex;gap:14rpx}.option{flex:1;padding:22rpx;border:2rpx solid #e1e7ed;border-radius:14rpx;color:#607286;text-align:center}.option.selected{border-color:#0f8d93;background:#e7f7f5;color:#0f7f89}.option.danger{border-color:#d65b62;background:#fff1f0;color:#d14343}.input,.textarea{width:100%;margin-top:14rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:12rpx;box-sizing:border-box;background:#fbfcfd;font-size:23rpx}.textarea{min-height:130rpx}.primary,.secondary,.button-row button{height:78rpx;margin-top:18rpx;border-radius:14rpx;font-size:24rpx;line-height:78rpx}.primary{background:#0f7f89;color:#fff}.secondary{background:#e7f7f5;color:#0f7f89}.button-row{display:flex;gap:14rpx}.button-row button{flex:1;margin-left:0;margin-right:0;background:#e7f7f5;color:#0f7f89}.button-row .warn,.warn{background:#fff1f0;color:#d14343}.full{width:100%}.tag-list{display:flex;flex-wrap:wrap;gap:12rpx}.tag{padding:12rpx 18rpx;border-radius:28rpx;background:#edf1f4;color:#607286;font-size:21rpx}.tag.active{background:#0f8d93;color:#fff}.private-tip,.api-tip{display:block;margin:-8rpx 0 16rpx;color:#98a4b1;font-size:20rpx}.api-tip{margin:12rpx 0 0;color:#b54708}.custom-row{margin-top:16rpx;display:flex;gap:12rpx}.custom-row input{flex:1;padding:16rpx;border:1rpx solid #dce4eb;border-radius:12rpx}.custom-row button{width:130rpx;margin:0;background:#e7f7f5;color:#0f7f89;font-size:22rpx}.selected-tags{margin-top:14rpx;color:#607286;font-size:21rpx}.submit{width:100%}.outlet{margin-top:14rpx;padding:20rpx;display:flex;align-items:center;justify-content:space-between;border:2rpx solid #edf1f4;border-radius:16rpx}.outlet.selected{border-color:#0f8d93;background:#f0fbf9}.outlet text{display:block;color:#40546a;font-size:23rpx}.outlet view text:last-child{margin-top:7rpx;color:#98a4b1;font-size:20rpx}.outlet>text{color:#0f7f89}.completed-tip,.message,.state{margin-top:20rpx;padding:24rpx;border-radius:18rpx;background:#e7f7ef;color:#168960;text-align:center}.message,.state.error{background:#fff5e8;color:#b54708}.state{background:#fff;color:#718095}
.section-note{display:block;margin-top:-8rpx;color:#8b98a7;font-size:21rpx}.question-heading{margin:32rpx 6rpx 0}.question-heading text{display:block;color:#25394f;font-size:30rpx;font-weight:700}.question-heading text:last-child{margin-top:8rpx;color:#98a4b1;font-size:20rpx;font-weight:400}.note-list{margin-top:18rpx;border-top:1rpx solid #edf1f4}.note-item{padding:18rpx 0;border-bottom:1rpx solid #edf1f4}.note-item text{display:block;color:#40546a;font-size:22rpx;line-height:1.55}.note-item text:last-child{margin-top:8rpx;color:#98a4b1;font-size:18rpx}.outlet view text+text{margin-top:6rpx;color:#98a4b1;font-size:20rpx}

.page{min-height:100vh;padding:28rpx 28rpx 50rpx;box-sizing:border-box;background:#f4f7fb}.status-card{padding:34rpx;display:flex;align-items:center;justify-content:space-between;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff;box-shadow:0 12rpx 30rpx rgba(15,127,137,.16)}.eyebrow{display:block;font-size:22rpx;opacity:.86}.status-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.status-desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.status-icon{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:rgba(255,255,255,.2);font-size:32rpx;font-weight:700}.detail-card,.review-card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 22rpx rgba(27,53,82,.05)}.merchant-card{border:1rpx solid #d8eeeb}.card-title{padding-bottom:20rpx;border-bottom:1rpx solid #edf0f4;color:#1d3045;font-size:29rpx;font-weight:700}.detail-row{min-height:78rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5}.label{color:#7b899a;font-size:23rpx}.value{max-width:440rpx;color:#34495f;font-size:24rpx;font-weight:600;text-align:right}.value.small{font-size:19rpx}.answer{color:#0f7f89}.commitment-title{margin:24rpx 0 10rpx;color:#7b899a;font-size:23rpx}.commitment-row{min-height:68rpx;display:flex;align-items:center;color:#53667a;font-size:23rpx}.check{width:34rpx;height:34rpx;margin-right:14rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#fdecec;color:#d14343}.check.accepted{background:#e7f7ef;color:#168960}.commitment-value{margin-left:auto;color:#168960}.review-tip{display:block;margin-top:20rpx;color:#77879a;font-size:22rpx;line-height:1.55}.reason-input{min-height:150rpx;margin-top:16rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:14rpx;box-sizing:border-box;background:#f9fbfc;font-size:23rpx}.approve-button,.reject-button{height:82rpx;border-radius:14rpx;font-size:26rpx;line-height:82rpx}.approve-button{margin-top:22rpx;background:#0f8d93;color:#fff}.reject-button{margin-top:14rpx;background:#fff0f0;color:#d14343}.approve-button::after,.reject-button::after{border:0}.message{display:block;margin-top:18rpx;color:#b54708;font-size:22rpx;text-align:center}.state-card{min-height:300rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:24rpx;background:#fff;color:#718095}.state-card.error{color:#b54708}.loading-ring{width:52rpx;height:52rpx;margin-bottom:20rpx;border:6rpx solid #dcefed;border-top-color:#0f7f89;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}

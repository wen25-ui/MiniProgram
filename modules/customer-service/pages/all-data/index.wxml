<view class="page">
  <view class="sticky-filter">
  <view class="header"><text class="title">全部业务数据</text><text class="desc">按处理阶段筛选客服可查看的申请与履约记录</text></view>
  <scroll-view class="filters" scroll-x="true" enable-flex="true"><view class="filter-row"><view wx:for="{{filters}}" wx:key="key" class="filter {{filter===item.key?'active':''}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}</view></view></scroll-view>
  <view class="summary"><text>{{filtered.length}}</text><text>条匹配数据</text></view>
  </view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取业务数据…</view>
  <view wx:for="{{filtered}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openDetail">
    <view class="head"><view><text class="phone">{{item.maskedPhone}}</text><text class="id">{{item.id}}</text></view><text class="status">{{item.statusText}}</text></view>
    <view class="row"><text>办理方式</text><text>{{item.serviceMode==='HOME_SERVICE'?'上门办理':item.serviceMode==='STORE_SERVICE'?'指定网点办理':'待确认'}}</text></view>
    <view class="row"><text>预约时间</text><text>{{item.appointmentTime||'待确认'}}</text></view>
    <view class="row"><text>最近更新</text><text>{{item.updatedAt||'--'}}</text></view>
    <view class="detail-entry"><text>查看业务详情</text><text>›</text></view>
  </view>
  <view wx:if="{{!loading&&!filtered.length}}" class="empty">当前筛选条件下没有数据</view>
  <role-bottom-nav role="customer-service" current="home"></role-bottom-nav>
</view>

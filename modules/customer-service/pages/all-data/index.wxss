.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.filters{margin:20rpx 0;padding:7rpx;border-radius:16rpx;background:#fff;white-space:nowrap}.filter-row{display:flex;width:840rpx;min-width:100%}.filter{min-width:130rpx;padding:16rpx 12rpx;border-radius:12rpx;color:#7c8998;font-size:21rpx;text-align:center;box-sizing:border-box}.filter.active{background:#e7f7f5;color:#0f7f89;font-weight:700}.summary{margin:20rpx 4rpx;display:flex;align-items:baseline;color:#7b8998;font-size:22rpx}.summary text:first-child{margin-right:9rpx;color:#0f7f89;font-size:36rpx;font-weight:700}.message{display:block;margin-bottom:16rpx;color:#b54708}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.05)}.head{display:flex;justify-content:space-between}.phone{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.id{display:block;margin-top:6rpx;color:#9ca6b3;font-size:18rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7f5;color:#0f7f89;font-size:21rpx}.row{min-height:62rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#8a96a5;font-size:21rpx}.row text:last-child{max-width:420rpx;color:#475a70;text-align:right}.empty{padding:80rpx 20rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}
.detail-entry{margin-top:18rpx;display:flex;align-items:center;justify-content:space-between;color:#0f7f89;font-size:23rpx;font-weight:600}

.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#168960,#50b88a);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.filters{margin-top:20rpx;padding:7rpx;display:flex;border-radius:16rpx;background:#fff}.filter{flex:1;padding:16rpx 8rpx;border-radius:12rpx;color:#7c8998;font-size:21rpx;text-align:center}.filter.active{background:#e7f7ef;color:#168960;font-weight:700}.summary{margin:20rpx 4rpx;display:flex;align-items:baseline;color:#7b8998;font-size:22rpx}.summary text:first-child{margin-right:9rpx;color:#168960;font-size:36rpx;font-weight:700}.message{display:block;margin-bottom:16rpx;color:#b54708}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.05)}.head{display:flex;justify-content:space-between}.phone{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.id{display:block;margin-top:6rpx;color:#9ca6b3;font-size:18rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7ef;color:#168960;font-size:21rpx}.completed-status{background:#edf4ff;color:#245f9d}.row{min-height:62rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f2f5;color:#8a96a5;font-size:21rpx}.row text:last-child{color:#475a70}.entry{margin-top:18rpx;display:flex;justify-content:space-between;color:#168960;font-size:24rpx;font-weight:600}.entry text:last-child{font-size:36rpx}.empty{padding:80rpx 20rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}
.rejected-status{background:#fff0f0;color:#c94b52}.filter.rejected-filter{background:#fff0f0;color:#c94b52}.reject-reason{margin-top:16rpx;padding:16rpx;border-radius:12rpx;background:#fff5f5}.reject-reason text{display:block;color:#a45a60;font-size:21rpx}.reject-reason text:first-child{font-weight:700}.reject-reason text:last-child{margin-top:6rpx;color:#6f6265;line-height:1.5}

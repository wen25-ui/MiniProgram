<view class="page">
  <view class="header"><text class="title">结果核销中心</text><text class="desc">与客户确认办理结果，并核实业务员提交的信息</text></view>
  <view class="summary"><text>{{verifications.length}}</text><text>笔订单等待核实</text></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取待核销订单…</view>
  <view wx:for="{{verifications}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openDetail">
    <view class="head"><view><text class="phone">{{item.maskedPhone}}</text><text class="id">{{item.id}}</text></view><text class="status">待核实</text></view>
    <view class="row"><text>办理类型</text><text>{{item.serviceMode==='HOME_SERVICE'?'上门办理':'指定网点办理'}}</text></view>
    <view class="row"><text>{{item.serviceMode==='HOME_SERVICE'?'办理人员':'办理网点'}}</text><text>{{item.serviceMode==='HOME_SERVICE'?item.salesmanName:item.outletName}}</text></view>
    <view class="row"><text>凭证提交时间</text><text>{{item.submittedAt}}</text></view>
    <view class="entry"><text>查看业务信息并核实</text><text>›</text></view>
  </view>
  <view wx:if="{{!loading&&!verifications.length}}" class="empty">当前没有待核销订单</view>
  <role-bottom-nav role="customer-service" current="verification"></role-bottom-nav>
</view>

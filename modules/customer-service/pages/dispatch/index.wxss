.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#0f7f89,#48b9b0);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.filters{margin:20rpx 0;padding:7rpx;border-radius:16rpx;background:#fff;white-space:nowrap}.filter-row{display:flex;width:850rpx}.filter-row>view{flex:1;padding:16rpx 8rpx;border-radius:12rpx;color:#7c8998;font-size:21rpx;text-align:center}.filter-row .active{background:#e7f7f5;color:#0f7f89;font-weight:700}.message{display:block;margin-bottom:16rpx;padding:15rpx;border-radius:12rpx;background:#fff5e8;color:#b54708}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(27,53,82,.05)}.head{display:flex;justify-content:space-between}.phone{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.id{display:block;margin-top:5rpx;color:#9ca6b3;font-size:18rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e7f7f5;color:#0f7f89;font-size:21rpx}.description{display:block;margin-top:20rpx;color:#6f7f91;font-size:22rpx}.input{min-height:78rpx;margin-top:14rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:12rpx;box-sizing:border-box;background:#fbfcfd;font-size:23rpx}.actions{margin-top:16rpx;display:flex;gap:14rpx}.actions button{flex:1}.primary,.secondary,.danger{height:74rpx;border-radius:12rpx;font-size:24rpx;line-height:74rpx}.primary{background:#0f7f89;color:#fff}.secondary{background:#e7f7f5;color:#0f7f89}.danger{background:#fff1f0;color:#d14343}.primary::after,.secondary::after,.danger::after{border:0}.full{width:100%;margin-top:16rpx}.picker{margin-top:18rpx;padding:24rpx;border-radius:14rpx;background:#0f7f89;color:#fff;text-align:center}.candidate-tip{margin-top:10rpx;color:#8a97a6;font-size:20rpx;text-align:center}.candidate-tip.fallback{padding:14rpx;border-radius:10rpx;background:#fff5e8;color:#b54708;line-height:1.45}.warning{margin-top:18rpx;padding:20rpx;border-radius:12rpx;background:#fff5e8;color:#b54708;font-size:22rpx;line-height:1.5}.voucher{margin-top:16rpx;padding:18rpx;border-radius:12rpx;background:#f5f8fa;color:#53667a;font-size:22rpx}.empty{padding:80rpx 20rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

<view class="page">
  <view class="sticky-filter">
  <view class="header"><text class="title">任务派遣中心</text><text class="desc">按审核确认的办理方式指定网点或派遣人员</text></view>
  <view class="filters"><view class="filter-row" style="width:100%">
    <view class="{{filter==='pending'?'active':''}}" data-filter="pending" bindtap="chooseFilter">待派遣</view>
    <view class="{{filter==='dispatched'?'active':''}}" data-filter="dispatched" bindtap="chooseFilter">已派遣</view>
    <view class="{{filter==='completed'?'active':''}}" data-filter="completed" bindtap="chooseFilter">已完成派遣</view>
  </view></view>
  <picker wx:if="{{filter==='dispatched'}}" range="{{dispatchTypeOptions}}" range-key="label" value="{{dispatchTypeIndex}}" bindchange="onDispatchTypeChange"><view style="margin:-8rpx 0 20rpx;padding:20rpx 24rpx;display:flex;justify-content:space-between;border-radius:14rpx;background:#fff;color:#53667a;font-size:23rpx"><text>派遣类型：{{dispatchTypeOptions[dispatchTypeIndex].label}}</text><text style="color:#0f7f89">下拉筛选⌄</text></view></picker>
  </view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取客服任务…</view>

  <view wx:for="{{filtered}}" wx:key="id" class="card">
    <view class="head"><view><text class="phone">{{item.maskedPhone}}</text><text class="id">{{item.id}}</text></view><text class="status">{{item.statusText}}</text></view>
    <text class="description">{{item.statusDescription}}</text>
    <view wx:if="{{item.taskStatusText}}" style="margin-top:12rpx;color:#0f7f89;font-size:22rpx">业务员任务状态：{{item.taskStatusText}}</view>
    <view style="margin-top:16rpx;padding:16rpx;border-radius:12rpx;background:#f6f9fa;color:#607286;font-size:21rpx"><text>派遣类型：{{item.serviceMode==='HOME_SERVICE'?'上门办理':item.serviceMode==='STORE_SERVICE'?'指定网点办理':'待确认'}}</text><text wx:if="{{item.serviceMode}}" style="display:block;margin-top:8rpx">服务地域：{{item.serviceRegion || '未填写'}}</text><text wx:if="{{item.serviceMode==='HOME_SERVICE'}}" style="display:block;margin-top:8rpx">客户地址：{{item.serviceAddress || '未填写'}}</text><text wx:if="{{item.serviceMode==='HOME_SERVICE'&&item.salesmanName}}" style="display:block;margin-top:8rpx">业务员：{{item.salesmanName}}</text><text wx:if="{{item.serviceMode==='STORE_SERVICE'&&item.merchantName}}" style="display:block;margin-top:8rpx">指定网点：{{item.merchantName}}</text></view>

    <block wx:if="{{item.status==='CONFIRMED'}}">
      <picker wx:if="{{item.serviceMode==='HOME_SERVICE'&&item.eligibleSalesmen.length}}" range="{{item.eligibleSalesmen}}" range-key="dispatchLabel" data-id="{{item.id}}" bindchange="onDispatchChange"><view class="picker">人工选择推荐业务员 ›</view></picker>
      <view wx:if="{{item.serviceMode==='HOME_SERVICE'&&item.eligibleSalesmen.length}}" class="candidate-tip {{item.salesmanNearbyFallback?'fallback':''}}">{{item.salesmanMatchLevel==='SAME_DISTRICT'?'同区推荐':item.salesmanMatchLevel==='NEIGHBOR_DISTRICT'?'同区无可派人员，按相邻区域配置推荐':'同区及相邻区无可派人员，显示成都范围全部可派人员'}}</view>
      <view wx:for="{{item.eligibleSalesmen}}" wx:for-item="salesman" wx:key="id" style="margin-top:10rpx;padding:14rpx;border-radius:10rpx;background:#f6f9fa;color:#607286;font-size:20rpx"><text>{{salesman.name}} · 进行中 {{salesman.activeTaskCount || 0}} 单</text><text wx:if="{{salesman.nextAppointmentTime}}" style="display:block;margin-top:6rpx">最近安排：{{salesman.nextAppointmentTime}}</text></view>
      <view wx:if="{{item.serviceMode==='HOME_SERVICE'&&!item.eligibleSalesmen.length}}" class="warning">当前没有可派遣的外派业务员，请管理员新增或启用外派业务员。</view>
      <picker wx:if="{{item.serviceMode==='STORE_SERVICE'&&item.eligibleOutlets.length}}" range="{{item.eligibleOutlets}}" range-key="outletLabel" data-id="{{item.id}}" bindchange="onOutletChange"><view class="picker">人工选择推荐网点 ›</view></picker>
      <view wx:if="{{item.serviceMode==='STORE_SERVICE'&&item.eligibleOutlets.length}}" class="candidate-tip {{item.outletNearbyFallback?'fallback':''}}">{{item.outletMatchLevel==='SAME_DISTRICT'?'同区推荐':item.outletMatchLevel==='NEIGHBOR_DISTRICT'?'同区无可用网点，按相邻区域配置推荐':'同区及相邻区无可用网点，显示成都范围全部可用网点'}}</view>
      <view wx:if="{{item.serviceMode==='STORE_SERVICE'&&!item.eligibleOutlets.length}}" class="warning">当前没有可指派网点，请管理员新增或启用网点。</view>
    </block>

  </view>
  <view wx:if="{{!loading&&!filtered.length}}" class="empty">当前环节暂无待办任务</view>
  <role-bottom-nav role="customer-service" current="dispatch"></role-bottom-nav>
</view>

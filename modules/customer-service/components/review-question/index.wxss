.question-card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 22rpx rgba(27,53,82,.05)}
.question-head{display:flex;align-items:flex-start}.number{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#e7f7f5;color:#0f7f89;font-size:22rpx;font-weight:700}.question-copy{min-width:0;flex:1;margin-left:16rpx}.title{display:block;color:#273b51;font-size:28rpx;font-weight:700;line-height:1.5}.state{display:block;margin-top:6rpx;color:#98a4b1;font-size:19rpx}.options{margin-top:20rpx;display:flex;flex-direction:column;gap:12rpx}.option{padding:20rpx;display:flex;align-items:center;justify-content:space-between;border:2rpx solid #e2e8ee;border-radius:14rpx;color:#607286;font-size:23rpx}.option.selected{border-color:#0f8d93;background:#e7f7f5;color:#0f7f89}.text-answer{width:100%;min-height:140rpx;margin-top:20rpx;padding:18rpx;box-sizing:border-box;border:1rpx solid #dce4eb;border-radius:14rpx;background:#fbfcfd;font-size:23rpx}.missing-options{margin-top:20rpx;padding:18rpx;border-radius:14rpx;background:#fff7e8;color:#a56a13;font-size:21rpx;line-height:1.5}

.task-card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:linear-gradient(135deg,#173f56,#246b73);color:#fff}.head{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:700}.status{padding:7rpx 14rpx;border-radius:22rpx;background:rgba(255,255,255,.16);font-size:19rpx}.grid{margin-top:20rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid view{padding:18rpx;border-radius:14rpx;background:rgba(255,255,255,.1)}.grid text{display:block;font-size:19rpx;opacity:.76}.grid text:last-child{margin-top:8rpx;font-size:23rpx;font-weight:600;opacity:1}.empty{margin-top:18rpx;color:rgba(255,255,255,.72);font-size:19rpx;text-align:center}

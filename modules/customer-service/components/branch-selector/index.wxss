.branch{margin-top:14rpx;padding:20rpx;display:flex;align-items:center;justify-content:space-between;border:2rpx solid #edf1f4;border-radius:16rpx}.branch.selected{border-color:#0f8d93;background:#f0fbf9}.branch text{display:block;color:#40546a;font-size:23rpx}.branch view text+text{margin-top:6rpx;color:#98a4b1;font-size:20rpx}.branch>text{color:#0f7f89}.empty{padding:32rpx;color:#98a4b1;text-align:center}.confirm{margin-top:20rpx;border-radius:14rpx;background:#0f7f89;color:#fff;font-size:24rpx}.confirm[disabled]{background:#c7d1d7;color:#fff}.confirm::after{border:0}

<view class="page"><view class="header"><text class="title">所属网点</text><text class="desc">网点与团队信息仅供查看</text></view><text wx:if="{{message}}" class="message">{{message}}</text><view wx:if="{{loading}}" class="empty">正在读取网点信息…</view><block wx:if="{{branch}}"><view class="card"><text class="card-title">{{branch.name}}</text><view class="row"><text>网点地址</text><text>{{branch.address || '未填写'}}</text></view><view class="row"><text>负责人</text><text>{{branch.managerName || branch.contactName || '未填写'}}</text></view><view class="row"><text>联系电话</text><text>{{branch.contactPhone || '未填写'}}</text></view></view><view class="card"><text class="card-title">团队成员</text><view wx:for="{{members}}" wx:key="id" class="member"><view class="avatar">{{index + 1}}</view><view><text>{{item.name}}</text><text>当前任务 {{item.taskCount}} 单 · {{item.canFieldService?'可执行外派':'仅到店任务'}}</text></view></view><view wx:if="{{!members.length}}" class="empty inner">暂无团队成员</view></view></block></view>

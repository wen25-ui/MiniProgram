.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.message{display:block;margin:18rpx 0;color:#b54708}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.card-title{display:block;margin-bottom:18rpx;color:#2d4156;font-size:29rpx;font-weight:700}.row{padding:16rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #edf0f4;color:#8290a0;font-size:22rpx}.row text:last-child{max-width:65%;color:#40546a;text-align:right}.member{padding:16rpx 0;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.avatar{width:52rpx;height:52rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#fff1e4;color:#d06b18}.member text{display:block;color:#40546a;font-size:23rpx}.member text:last-child{margin-top:5rpx;color:#98a4b1;font-size:20rpx}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}.empty.inner{margin:0;padding:40rpx}

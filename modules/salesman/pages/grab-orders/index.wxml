<view class="page"><view class="header"><text class="title">抢单大厅</text><text class="desc">仅展示所属网点开放抢单的订单</text></view><text wx:if="{{message}}" class="message">{{message}}</text><view wx:if="{{loading}}" class="empty">正在读取可抢任务…</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="head"><view><text class="customer">{{item.customerName}}</text><text class="type">{{item.businessType}}</text></view><text class="income">¥ {{item.expectedIncome || '0.00'}}</text></view><view class="row"><text>发布时间</text><text>{{item.publishedAt}}</text></view><button class="grab" loading="{{grabbingId == item.id}}" disabled="{{grabbingId}}" data-id="{{item.id}}" bindtap="grab">立即抢单</button></view><view wx:if="{{!loading && !orders.length}}" class="empty">当前网点暂无可抢任务</view></view>

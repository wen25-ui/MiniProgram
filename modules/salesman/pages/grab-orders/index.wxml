<view class="page"><view class="header"><text class="title">任务领取大厅</text><text class="desc">仅展示所属网点且当前账号有能力领取的任务</text></view><text wx:if="{{message}}" class="message">{{message}}</text><view wx:if="{{loading}}" class="empty">正在读取可领取任务…</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="head"><view><text class="customer">{{item.customerName}}</text><text class="type">{{item.businessType}}</text></view><text class="income">¥ {{item.expectedIncome || '0.00'}}</text></view><view class="row"><text>客户电话</text><text>{{item.maskedPhone}}</text></view><view class="row"><text>发布时间</text><text>{{item.publishedAt}}</text></view><button class="grab" loading="{{grabbingId == item.id}}" disabled="{{grabbingId}}" data-id="{{item.id}}" bindtap="grab">立即领取</button></view><view wx:if="{{!loading && !orders.length}}" class="empty">当前网点暂无可领取任务</view></view>

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:34rpx;border-radius:28rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.message{display:block;margin:18rpx 0;padding:16rpx;border-radius:12rpx;background:#fff0ef;color:#bd3f3f}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.head{display:flex;justify-content:space-between}.customer{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.type{display:block;margin-top:7rpx;color:#8694a5;font-size:21rpx}.income{color:#d06b18;font-size:28rpx;font-weight:700}.row{padding:15rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #edf0f4;color:#8290a0;font-size:22rpx}.row text:last-child{color:#40546a}.grab{margin-top:20rpx;border-radius:14rpx;background:#d06b18;color:#fff}.grab::after{border:0}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

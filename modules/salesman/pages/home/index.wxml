<view class="page"><view class="hero"><view><text class="eyebrow">业务员工作台</text><text class="hero-title">{{session.salesmanType==='BRANCH'?'我的网点任务':'我的上门任务'}}</text><text class="hero-desc">按接收、联系、约时、办理和结果上传的顺序处理任务</text></view><view class="hero-icon">办</view></view><text wx:if="{{message}}" class="message">{{message}}</text><view class="stats"><view><text class="value">{{stats.waiting}}</text><text>待接收/联系</text></view><view><text class="value orange">{{stats.servicing}}</text><text>待办理/上传</text></view><view><text class="value green">{{stats.verification}}</text><text>待核销</text></view></view><button class="task-button" bindtap="goTasks">进入业务员任务中心</button><view class="section-head"><text>近期任务</text><text bindtap="goTasks">查看全部 ›</text></view><view wx:if="{{applications.length}}" class="list"><view wx:for="{{applications}}" wx:key="id" class="row"><view class="date-icon">{{index+1}}</view><view class="main"><text>{{item.maskedPhone}}</text><text>{{item.appointmentTime || '时间待确认'}}</text></view><text class="status">{{item.statusText}}</text></view></view><view wx:else class="empty">当前没有待处理任务</view><role-bottom-nav role="salesman" current="home"></role-bottom-nav></view>

<view class="page"><view class="hero"><view><text class="eyebrow">业务员工作台</text><text class="hero-title">我的上门任务</text><text class="hero-desc">按预约安排上门、实名核实并提交办理凭证</text></view><view class="hero-icon">办</view></view><text wx:if="{{message}}" class="message">{{message}}</text><view class="stats"><view><text class="value">{{stats.waiting}}</text><text>待上门</text></view><view><text class="value orange">{{stats.servicing}}</text><text>办理中/待补充</text></view><view><text class="value green">{{stats.verification}}</text><text>待核销</text></view></view><button class="task-button" bindtap="goTasks">进入上门任务中心</button><view class="section-head"><text>近期任务</text><text bindtap="goTasks">查看全部 ›</text></view><view wx:if="{{applications.length}}" class="list"><view wx:for="{{applications}}" wx:key="id" class="row"><view class="date-icon">{{index+1}}</view><view class="main"><text>{{item.maskedPhone}}</text><text>{{item.appointmentTime || '时间待确认'}}</text></view><text class="status">{{item.statusText}}</text></view></view><view wx:else class="empty">当前没有上门任务</view><role-bottom-nav role="salesman" current="home"></role-bottom-nav></view>

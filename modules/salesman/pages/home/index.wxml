<view class="page">
  <view class="hero"><view><text class="eyebrow">业务员工作台</text><text class="hero-title">我的业务任务</text><text class="hero-desc">所属网点：{{branchName}}</text></view><view class="hero-icon">办</view></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view class="stats"><view><text class="value">{{stats.pending}}</text><text>待处理</text></view><view><text class="value orange">{{stats.processing}}</text><text>办理中</text></view><view><text class="value green">{{stats.submitting}}</text><text>待提交</text></view><view><text class="value done">{{stats.completed}}</text><text>已完成</text></view></view>
  <view class="income"><text class="card-title">收益概览</text><view><text>预计佣金</text><text>¥ {{income.estimated}}</text></view><view><text>已完成佣金</text><text>¥ {{income.completed}}</text></view></view>
  <view class="actions"><button bindtap="goTasks">我的任务</button><button class="grab-entry" bindtap="goGrabOrders">抢单大厅</button><button bindtap="goBranch">所属网点</button></view>
  <view wx:if="{{pendingTransfers.length}}" class="section-head"><text>待处理转接</text><text>{{pendingTransfers.length}} 条</text></view>
  <transfer-request wx:for="{{pendingTransfers}}" wx:key="id" request="{{item}}" operating-id="{{operatingTransferId}}" bind:decide="decideTransfer"/>
  <view wx:if="{{transferApiUnavailable}}" class="todo-tip">待处理转接查询接口尚未接入。<!-- TODO: GET /salesman/transfers?status=PENDING --></view>
  <view class="section-head"><text>近期任务</text><text bindtap="goTasks">查看全部 ›</text></view>
  <view wx:if="{{tasks.length}}" class="list"><view wx:for="{{tasks}}" wx:key="id" class="row"><view class="date-icon">{{index + 1}}</view><view class="main"><text>{{item.customerName || item.maskedPhone || '客户'}}</text><text>{{item.projectName}} · {{item.sourceText}}</text></view><text class="status">{{item.salesmanStatusText}}</text></view></view>
  <view wx:else class="empty">{{loading ? '正在读取工作台…' : '当前没有任务'}}</view>
  <role-bottom-nav role="salesman" current="home"></role-bottom-nav>
</view>

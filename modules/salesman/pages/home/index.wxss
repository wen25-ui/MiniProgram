.page{min-height:100vh;padding:28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f7fb}.hero{padding:36rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff;box-shadow:0 14rpx 32rpx rgba(208,107,24,.18)}.eyebrow{display:block;font-size:23rpx;opacity:.86}.hero-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.hero-desc{display:block;margin-top:12rpx;font-size:22rpx;opacity:.86}.hero-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:35rpx;font-weight:700}.message{display:block;margin-top:18rpx;color:#b54708}.stats{margin-top:22rpx;padding:26rpx 4rpx;display:flex;border-radius:24rpx;background:#fff}.stats>view{flex:1;text-align:center}.stats>view+view{border-left:1rpx solid #edf0f4}.value{display:block;color:#d06b18;font-size:34rpx;font-weight:700}.value.orange{color:#d78012}.value.green{color:#168960}.value.done{color:#4d6f8f}.stats text:last-child{display:block;margin-top:7rpx;color:#8b97a6;font-size:18rpx}.income{margin-top:16rpx;padding:26rpx;border-radius:24rpx;background:#fff}.card-title{display:block;margin-bottom:14rpx;color:#2f4358;font-size:27rpx;font-weight:700}.income view{padding:12rpx 0;display:flex;justify-content:space-between;color:#8090a1;font-size:22rpx}.income view text:last-child{color:#d06b18;font-weight:700}.actions{margin-top:18rpx;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx}.actions button{margin:0;border-radius:14rpx;background:#fff4e8;color:#d06b18;font-size:21rpx}.actions .grab-entry{background:#d06b18;color:#fff}.actions button::after{border:0}.section-head{margin:30rpx 6rpx 14rpx;display:flex;justify-content:space-between;color:#2f4358;font-size:27rpx;font-weight:700}.section-head text:last-child{color:#d06b18;font-size:21rpx;font-weight:400}.list{padding:0 24rpx;border-radius:24rpx;background:#fff}.row{min-height:102rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.row:last-child{border-bottom:0}.date-icon{width:50rpx;height:50rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#fff1e4;color:#d06b18}.main{min-width:0;flex:1}.main text{display:block;color:#35495e;font-size:23rpx}.main text:last-child{margin-top:5rpx;color:#9aa5b2;font-size:19rpx}.status{color:#d06b18;font-size:20rpx}.empty{padding:70rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}.todo-tip{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#fff7e8;color:#a56a13;font-size:20rpx}

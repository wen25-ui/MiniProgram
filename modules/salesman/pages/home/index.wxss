.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:36rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff;box-shadow:0 14rpx 32rpx rgba(208,107,24,.18)}.eyebrow{display:block;font-size:23rpx;opacity:.86}.hero-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.hero-desc{display:block;max-width:480rpx;margin-top:12rpx;font-size:22rpx;line-height:1.45;opacity:.86}.hero-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:35rpx;font-weight:700}.message{display:block;margin-top:18rpx;color:#b54708}.stats{margin-top:22rpx;padding:26rpx 10rpx;display:flex;border-radius:23rpx;background:#fff}.stats view{flex:1;display:flex;flex-direction:column;align-items:center;color:#929dab;font-size:19rpx;text-align:center}.value{margin-bottom:7rpx;color:#2e4156;font-size:36rpx;font-weight:700}.value.orange{color:#d06b18}.value.green{color:#168960}.task-button{margin-top:22rpx;border-radius:14rpx;background:#d06b18;color:#fff}.task-button::after{border:0}.section-head{margin:32rpx 6rpx 16rpx;display:flex;justify-content:space-between}.section-head text:first-child{font-size:31rpx;font-weight:700}.section-head text:last-child{color:#d06b18;font-size:22rpx}.list{padding:0 25rpx;border-radius:24rpx;background:#fff}.row{min-height:104rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.row:last-child{border-bottom:0}.date-icon{width:52rpx;height:52rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#fff1e4;color:#d06b18}.main{flex:1}.main text:first-child{display:block;color:#314459;font-size:24rpx;font-weight:600}.main text:last-child{display:block;margin-top:4rpx;color:#a0aab7;font-size:19rpx}.status{color:#d06b18;font-size:21rpx}.empty{padding:70rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

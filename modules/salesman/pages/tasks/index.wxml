<view class="page"><view class="header"><text class="title">{{session.salesmanType==='BRANCH'?'网点待办任务':'上门任务中心'}}</text><text class="desc">{{session.salesmanType==='BRANCH'?'等待客户到网点，完成实名核实与办理':'完成实名核实、业务办理和凭证提交'}}</text></view><text wx:if="{{message}}" class="message">{{message}}</text><view wx:for="{{applications}}" wx:key="id" class="card"><view class="head"><view><text class="phone">{{item.maskedPhone}}</text><text class="id">{{item.id}}</text></view><text class="status">{{item.statusText}}</text></view><view class="appointment"><text>{{item.serviceMode==='STORE_SERVICE'?'办理方式':'预约上门'}}</text><text>{{item.serviceMode==='STORE_SERVICE'?'客户到网点':(item.appointmentTime || '待确认')}}</text></view><text class="description">{{item.statusDescription}}</text><button wx:if="{{item.status==='PENDING_SERVICE'||item.status==='PENDING_STORE_SERVICE'}}" class="primary full" data-id="{{item.id}}" data-action="start" bindtap="operate">{{item.status==='PENDING_STORE_SERVICE'?'客户已到网点，开始办理':'开始上门办理'}}</button><block wx:if="{{item.status==='IN_SERVICE'||item.status==='IN_STORE_SERVICE'||item.status==='VERIFICATION_RETURNED'}}"><view wx:if="{{item.status==='VERIFICATION_RETURNED'}}" class="return-reason">退回原因：{{item.verification.reason}}</view><view class="verify" data-id="{{item.id}}" bindtap="toggleVerified"><view class="checkbox {{verified[item.id]?'checked':''}}">{{verified[item.id]?'✓':''}}</view><text>确认已完成客户实名核实</text></view><textarea class="input" placeholder="填写办理结果与凭证说明" data-id="{{item.id}}" bindinput="onRemarkInput"/><textarea wx:if="{{item.status==='IN_SERVICE'||item.status==='IN_STORE_SERVICE'}}" class="input" placeholder="办理失败时填写原因" data-id="{{item.id}}" bindinput="onFailureReasonInput"/><view class="task-actions"><button class="primary" data-id="{{item.id}}" data-action="submit" bindtap="operate">提交凭证并申请核销</button><button wx:if="{{item.status==='IN_SERVICE'||item.status==='IN_STORE_SERVICE'}}" class="danger" data-id="{{item.id}}" data-action="fail" bindtap="operate">办理失败</button></view></block><view wx:if="{{item.status==='PENDING_VERIFICATION'}}" class="waiting"><text class="waiting-icon">✓</text><text>凭证已提交，等待客服核销</text></view></view><view wx:if="{{!applications.length}}" class="empty">暂无待处理任务</view><role-bottom-nav role="salesman" current="tasks"></role-bottom-nav></view>

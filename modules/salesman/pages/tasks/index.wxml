<view class="page">
  <view class="sticky-head"><view class="header"><text class="title">我的任务</text><text class="desc">仅展示当前业务员负责的订单</text></view><scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><view wx:for="{{filters}}" wx:key="key" class="filter {{filter === item.key ? 'active' : ''}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}</view></view></scroll-view></view>
  <text wx:if="{{message}}" class="message">{{message}}</text><view wx:if="{{loading}}" class="empty">正在读取我的任务…</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openTask"><view class="head"><view><text class="phone">{{item.customerName || '客户'}} · {{item.maskedPhone}}</text><text class="id">{{item.applicationId}}</text></view><text class="status">{{item.salesmanStatusText}}</text></view><view class="detail"><text>办理项目</text><text>{{item.projectName}}</text></view><view class="detail"><text>订单来源</text><text>{{item.sourceText}}</text></view><view class="detail"><text>更新时间</text><text>{{item.updatedAt || '未记录'}}</text></view><view class="open">查看详情并处理 ›</view></view>
  <view wx:if="{{!loading && !tasks.length}}" class="empty">当前分类暂无任务</view><role-bottom-nav role="salesman" current="tasks"></role-bottom-nav>
</view>

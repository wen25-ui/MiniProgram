<view class="page">
  <view class="sticky-head">
    <view class="header"><text class="title">{{session.salesmanType==='BRANCH'?'网点任务中心':'上门任务中心'}}</text><text class="desc">接收任务后按联系、约时、办理、上传结果的顺序处理</text></view>
    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><view wx:for="{{filters}}" wx:key="key" class="filter {{filter===item.key?'active':''}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}</view></view></scroll-view>
  </view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取任务…</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openTask">
    <view class="head"><view><text class="phone">{{item.customerName}} · {{item.maskedPhone}}</text><text class="id">{{item.applicationId}}</text></view><text class="status">{{item.statusText}}</text></view>
    <view class="detail"><text>办理方式</text><text>{{item.serviceType==='HOME_SERVICE'?'上门办理':'到店办理'}}</text></view>
    <view class="detail"><text>办理时间</text><text>{{item.appointmentTime || '待确认'}}</text></view>
    <view wx:if="{{item.serviceType==='STORE_SERVICE'}}" class="detail"><text>指定网点</text><text>{{item.storeName || '待确认'}}</text></view>
    <view wx:if="{{item.contactFailCount}}" class="contact-warning">已有 {{item.contactFailCount}} 次联系失败记录</view>
    <view class="open">查看详情并处理 ›</view>
  </view>
  <view wx:if="{{!loading&&!tasks.length}}" class="empty">当前分类暂无任务</view>
  <role-bottom-nav role="salesman" current="tasks"></role-bottom-nav>
</view>

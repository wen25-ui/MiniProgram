.page{min-height:100vh;padding:0 28rpx 150rpx;box-sizing:border-box;background:#f4f7fb}.sticky-head{position:sticky;top:0;z-index:10;padding-top:28rpx;background:#f4f7fb}.header{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.filters{width:100%;padding:18rpx 0;background:#f4f7fb;white-space:nowrap}.filter-row{display:inline-flex;gap:12rpx}.filter{padding:14rpx 24rpx;border-radius:28rpx;background:#fff;color:#718194;font-size:22rpx}.filter.active{background:#d06b18;color:#fff}.message{display:block;margin:18rpx 0;color:#b54708}.card{margin-bottom:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.head{display:flex;justify-content:space-between;gap:18rpx}.phone{display:block;color:#2d4156;font-size:27rpx;font-weight:700}.id{display:block;margin-top:6rpx;color:#9ca6b3;font-size:18rpx}.status{height:42rpx;padding:7rpx 15rpx;border-radius:24rpx;background:#fff1e4;color:#d06b18;font-size:20rpx;white-space:nowrap}.detail{margin-top:18rpx;display:flex;justify-content:space-between;color:#7f8c9c;font-size:22rpx}.detail text:last-child{max-width:65%;color:#40546a;text-align:right}.contact-warning{margin-top:18rpx;padding:16rpx;border-radius:12rpx;background:#fff0ef;color:#bd3f3f;font-size:21rpx}.open{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #edf0f4;color:#d06b18;font-size:22rpx;text-align:right}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.message{display:block;margin:18rpx 0;color:#b54708}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.head{display:flex;justify-content:space-between}.phone{display:block;color:#2d4156;font-size:28rpx;font-weight:700}.id{display:block;margin-top:5rpx;color:#9ca6b3;font-size:18rpx}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#fff1e4;color:#d06b18;font-size:21rpx}.appointment{margin-top:22rpx;padding:20rpx;display:flex;justify-content:space-between;border-radius:15rpx;background:#f8f9fb;color:#7f8c9c;font-size:22rpx}.appointment text:last-child{color:#40546a;font-weight:600}.description{display:block;margin-top:18rpx;color:#718194;font-size:22rpx;line-height:1.5}.primary,.danger{height:76rpx;border-radius:12rpx;font-size:24rpx;line-height:76rpx}.primary{background:#d06b18;color:#fff}.danger{background:#fff0ef;color:#bd3f3f}.primary::after,.danger::after{border:0}.full{width:100%;margin-top:18rpx}.task-actions{margin-top:18rpx;display:flex;gap:14rpx}.task-actions button{flex:1}.verify{margin-top:20rpx;padding:20rpx;display:flex;align-items:center;border-radius:14rpx;background:#fff8f1;color:#586b7e;font-size:23rpx}.checkbox{width:38rpx;height:38rpx;margin-right:15rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #d7c1ad;border-radius:8rpx;color:#fff}.checkbox.checked{border-color:#d06b18;background:#d06b18}.input{min-height:120rpx;margin-top:16rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:12rpx;box-sizing:border-box;background:#fbfcfd;font-size:23rpx}.return-reason{margin-top:18rpx;padding:18rpx;border-radius:13rpx;background:#fff0ef;color:#bd3f3f;font-size:22rpx}.waiting{margin-top:20rpx;padding:24rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#eaf8f2;color:#168960;font-size:23rpx}.waiting-icon{width:34rpx;height:34rpx;margin-right:12rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#168960;color:#fff}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

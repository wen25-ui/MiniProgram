.page{min-height:100vh;padding:28rpx 28rpx 150rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.categories{display:flex;gap:12rpx;padding:18rpx 0}.category{flex:1;padding:14rpx 8rpx;border-radius:28rpx;background:#fff;color:#718194;font-size:21rpx;text-align:center}.category.active{background:#d06b18;color:#fff}.message{display:block;margin:18rpx 0;color:#b54708}.schedule-card{display:flex;gap:22rpx;margin-bottom:20rpx;padding:26rpx;border-radius:24rpx;background:#fff}.time-box{width:150rpx;flex:none;padding-right:22rpx;border-right:1rpx solid #edf0f4;display:flex;flex-direction:column;justify-content:center}.date{color:#718194;font-size:20rpx}.clock{margin-top:8rpx;color:#d06b18;font-size:34rpx;font-weight:700}.task-main{min-width:0;flex:1}.task-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.customer{overflow:hidden;color:#2d4156;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.status{flex:none;padding:6rpx 12rpx;border-radius:18rpx;background:#fff1e4;color:#d06b18;font-size:19rpx}.status.rejected{background:#fff0ef;color:#bd3f3f}.address{display:block;margin-top:16rpx;color:#40546a;font-size:22rpx}.reject-reason{display:block;margin-top:10rpx;color:#bd3f3f;font-size:20rpx}.order{display:block;margin-top:10rpx;color:#9ca6b3;font-size:18rpx}.empty{margin-top:0;padding:80rpx 30rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

<view class="page">
  <view class="header"><text class="title">任务日程</text><text class="desc">仅展示当前业务员订单的预约安排</text></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{scheduleApiUnavailable}}" class="message">日程接口待后端接入，当前兼容展示本人任务中的预约信息。</view>
  <view wx:if="{{loading}}" class="empty">正在读取任务安排…</view>
  <view wx:for="{{schedules}}" wx:key="id" class="schedule-card" data-id="{{item.id}}" bindtap="openTask"><view class="time-box"><text class="date">{{item.executionDate}}</text><text class="clock">{{item.executionClock}}</text></view><view class="task-main"><view class="task-head"><text class="customer">{{item.customerName || '客户'}}</text><text class="status">{{item.salesmanStatusText}}</text></view><text class="address">{{item.address}}</text><text class="order">{{item.applicationId}}</text></view></view>
  <view wx:if="{{!loading && !schedules.length}}" class="empty">当前没有预约日程</view>
  <role-bottom-nav role="salesman" current="schedule"></role-bottom-nav>
</view>

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.message{display:block;margin-bottom:18rpx;color:#b54708}.summary{padding:32rpx;display:flex;align-items:center;justify-content:space-between;border-radius:26rpx;background:linear-gradient(135deg,#d06b18,#ed9a43);color:#fff}.eyebrow{display:block;font-size:21rpx;opacity:.86}.title{display:block;margin-top:8rpx;font-size:36rpx;font-weight:700}.badge{padding:10rpx 16rpx;border-radius:25rpx;background:rgba(255,255,255,.2);font-size:20rpx}.card,.action-card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.action-card{box-shadow:0 10rpx 28rpx rgba(37,53,72,.06)}.card-title{display:block;margin-bottom:18rpx;color:#2d4156;font-size:28rpx;font-weight:700}.row{padding:15rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #edf0f4;color:#8290a0;font-size:22rpx}.row text:last-child{max-width:65%;color:#40546a;text-align:right}.phone-actions{margin:14rpx 0;display:flex;gap:14rpx}.phone-actions button{flex:1;height:68rpx;background:#fff4e8;color:#d06b18;font-size:22rpx;line-height:68rpx}.phone-actions button::after{border:0}.hint{display:block;color:#7f8c9c;font-size:22rpx;line-height:1.6}.primary,.danger-button{margin-top:20rpx;height:78rpx;border-radius:13rpx;color:#fff;font-size:24rpx;line-height:78rpx}.primary{background:#d06b18}.danger-button{background:#bd3f3f}.primary::after,.danger-button::after{border:0}radio-group{display:flex;gap:34rpx;color:#53667a;font-size:23rpx}.picker{margin-top:16rpx;padding:20rpx;border:1rpx solid #dce4eb;border-radius:12rpx;color:#40546a;font-size:23rpx}.picker-row{display:flex;gap:14rpx}.picker-row picker{flex:1}.textarea{width:100%;min-height:120rpx;margin-top:16rpx;padding:18rpx;border:1rpx solid #dce4eb;border-radius:12rpx;box-sizing:border-box;background:#fbfcfd;font-size:23rpx}.textarea.compact{height:82rpx;min-height:82rpx}.textarea.result{min-height:190rpx}.check{margin-top:12rpx;padding:18rpx;display:flex;align-items:center;border-radius:12rpx;background:#fff8f1;color:#586b7e;font-size:23rpx}.box{width:38rpx;height:38rpx;margin-right:14rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #d7c1ad;border-radius:8rpx}.box.checked{border-color:#d06b18;background:#d06b18;color:#fff}.notice{margin-top:20rpx;padding:26rpx;border-radius:20rpx;font-size:23rpx}.notice.success{background:#eaf8f2;color:#168960}.notice.danger{background:#fff0ef;color:#bd3f3f}.abnormal{margin-top:20rpx}.link-danger{background:transparent;color:#bd3f3f;font-size:22rpx}.link-danger::after{border:0}.record{padding:16rpx 0;border-bottom:1rpx solid #edf0f4}.record text{display:block;color:#40546a;font-size:22rpx}.record text+text{margin-top:6rpx;color:#929dab;font-size:20rpx}.empty{padding:80rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

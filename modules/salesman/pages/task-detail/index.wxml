<view class="page">
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取任务详情…</view>
  <block wx:if="{{task}}">
    <view class="summary"><view><text class="eyebrow">{{task.serviceType==='HOME_SERVICE'?'外派办理任务':'到店办理任务'}}</text><text class="title">{{task.salesmanStatusText}}</text></view><text class="badge">{{task.contactFailCount?'联系失败 '+task.contactFailCount+' 次':'流程正常'}}</text></view>

    <transfer-request wx:if="{{pendingTransfer}}" request="{{pendingTransfer}}" operating-id="{{operatingTransferId}}" bind:decide="decideIncomingTransfer"/>
    <view wx:if="{{transferApiUnavailable}}" class="notice">待处理转接查询接口尚未接入。<!-- TODO: GET /salesman/transfers?status=PENDING --></view>

    <view class="card"><text class="card-title">客户与订单</text><view class="row"><text>客户姓名</text><text>{{task.customerName}}</text></view><view class="row"><text>联系电话</text><text>{{task.customerPhone || task.maskedPhone}}</text></view><view wx:if="{{!task.summaryOnly}}" class="phone-actions"><button bindtap="callCustomer">拨打电话</button><button bindtap="copyPhone">复制号码</button></view><view class="row"><text>订单编号</text><text>{{task.applicationId}}</text></view><view class="row"><text>办理项目</text><text>{{task.projectName}}</text></view><view class="row"><text>任务来源</text><text>{{task.sourceText}}</text></view><view class="row"><text>所属网点</text><text>{{task.branchName}}</text></view><view class="row"><text>任务办理方式</text><text>{{task.serviceType==='HOME_SERVICE'?'外派办理':'到店办理'}}</text></view><view class="row"><text>当前负责人</text><text>{{task.assigneeName || '待领取'}}</text></view><view class="row"><text>办理地址</text><text>{{task.summaryOnly?'领取后可查看详细地址':(task.serviceAddress||task.storeName||'暂未填写')}}</text></view><view class="row"><text>办理时间</text><text>{{task.appointmentTime || '待确认'}}</text></view></view>

    <view wx:if="{{task.status==='PENDING_ACCEPT'||task.status==='WAIT_ASSIGN'}}" class="action-card"><text class="card-title">接收任务</text><text class="hint">接收后请先联系客户，不会直接进入办理中。</text><button class="primary" loading="{{operating}}" bindtap="accept">确认接收任务</button></view>

    <view wx:if="{{task.status==='ACCEPTED'||task.status==='WAITING_CONTACT'||task.status==='CONTACT_FAILED'}}" class="action-card"><text class="card-title">{{task.status==='CONTACT_FAILED'?'重新联系客户':'联系客户'}}</text><radio-group bindchange="chooseContactResult"><label><radio value="CONTACT_SUCCESS" checked="{{contactResult==='CONTACT_SUCCESS'}}" color="#d06b18"/>联系成功</label><label><radio value="CONTACT_FAILED" checked="{{contactResult==='CONTACT_FAILED'}}" color="#d06b18"/>联系失败</label></radio-group><picker wx:if="{{contactResult==='CONTACT_FAILED'}}" range="{{failureReasonLabels}}" value="{{failureReasonIndex}}" bindchange="chooseFailureReason"><view class="picker">失败原因：{{failureReasonLabels[failureReasonIndex]}} ›</view></picker><view wx:if="{{contactResult==='CONTACT_SUCCESS'&&task.serviceType==='HOME_SERVICE'}}"><text class="hint">请向客户确认上门地址，不正确可直接修改</text><textarea class="textarea" value="{{contactAddress}}" placeholder="客户详细上门地址" data-field="contactAddress" bindinput="input"/></view><textarea class="textarea compact" placeholder="填写本次联系备注" data-field="contactRemark" bindinput="input"/><button class="primary" loading="{{operating}}" bindtap="submitContact">保存联系结果</button></view>

    <view wx:if="{{task.status==='WAITING_TIME_CONFIRMATION'}}" class="action-card"><text class="card-title">确认{{task.serviceType==='HOME_SERVICE'?'上门':'预计到店'}}时间</text><view class="picker-row"><picker mode="date" value="{{appointmentDate}}" start="{{appointmentDate}}" bindchange="chooseDate"><view class="picker">{{appointmentDate}}</view></picker><picker mode="time" value="{{appointmentTime}}" bindchange="chooseTime"><view class="picker">{{appointmentTime}}</view></picker></view><view wx:if="{{task.serviceType==='HOME_SERVICE'}}" class="hint">已确认地址：{{task.serviceAddress}}</view><button class="primary" loading="{{operating}}" bindtap="confirmAppointment">确认办理时间</button></view>

    <view wx:if="{{task.status==='WAITING_HOME_SERVICE'||task.status==='WAITING_CUSTOMER_ARRIVAL'}}" class="action-card"><text class="card-title">{{task.status==='WAITING_HOME_SERVICE'?'按约上门':'等待客户到店'}}</text><text class="hint">预约时间：{{task.appointmentTime}}</text><button class="primary" loading="{{operating}}" bindtap="arrive">{{task.status==='WAITING_HOME_SERVICE'?'我已到达上门地点':'客户已到店'}}</button></view>

    <view wx:if="{{task.status==='WAITING_START_CONFIRMATION'}}" class="action-card"><text class="card-title">开始办理确认</text><text class="hint">请先取得客户或现场工作人员确认。确认失败时请使用异常结束并填写原因。</text><button class="primary" loading="{{operating}}" bindtap="start">确认开始办理</button></view>

    <view wx:if="{{task.status==='PROCESSING'}}" class="action-card"><text class="card-title">当前办理</text><textarea class="textarea" placeholder="可填写本次办理过程备注" data-field="processingRemark" bindinput="input"/><button class="primary" loading="{{operating}}" bindtap="finish">办理完成，下一步上传结果</button></view>

    <view wx:if="{{task.status==='WAITING_RESULT_UPLOAD'||task.status==='DOCUMENT_PENDING'}}" class="action-card"><text class="card-title">上传办理结果</text><view class="check" bindtap="toggleVerified"><text class="box {{identityVerified?'checked':''}}">{{identityVerified?'✓':''}}</text><text>确认已完成客户实名核验</text></view><textarea class="textarea result" value="{{resultDescription}}" placeholder="填写办理结果、现场情况和凭证说明" data-field="resultDescription" bindinput="input"/><button class="primary" loading="{{operating}}" bindtap="uploadResult">提交结果进入审核</button></view>

    <view wx:if="{{task.status==='PENDING_VERIFICATION'||task.status==='AUDITING'}}" class="notice success">办理结果已上传，正在审核中。</view><view wx:if="{{task.status==='TRANSFER_PENDING'}}" class="notice success">转接申请已提交，等待接收人确认。</view><view wx:if="{{task.status==='COMPLETED'||task.status==='FINISHED'}}" class="notice success">任务已完成。</view><view wx:if="{{task.status==='ABNORMAL_CLOSED'||task.status==='PROCESSING_FAILED'||task.status==='CANCELLED'||task.status==='FAILED'}}" class="notice danger">任务已失败：{{task.failReason || '未填写原因'}}</view>

    <view wx:if="{{task.canAbnormalClose}}" class="abnormal"><button class="link-danger" bindtap="toggleAbnormal">{{showAbnormal?'取消异常处理':'无法继续办理 / 异常结束'}}</button><view wx:if="{{showAbnormal}}"><textarea class="textarea" placeholder="必须填写异常原因" data-field="abnormalReason" bindinput="input"/><button class="danger-button" loading="{{operating}}" bindtap="abnormalClose">确认异常结束</button></view></view>

    <view wx:if="{{task.canTransfer}}" class="action-card"><button class="transfer-link" bindtap="toggleTransfer">{{showTransfer?'取消转接':'转接订单'}}</button><view wx:if="{{showTransfer}}"><text class="hint">只能转给当前网点的其他业务员</text><picker wx:if="{{transferMembers.length}}" range="{{transferLabels}}" value="{{transferIndex}}" bindchange="chooseTransferMember"><view class="picker">接收人：{{transferLabels[transferIndex]}} ›</view></picker><text wx:else class="hint">当前网点没有其他可选业务员</text><textarea class="textarea" placeholder="填写转接原因" data-field="transferReason" bindinput="input"/><button class="primary" loading="{{operating}}" bindtap="submitTransfer">提交转接申请</button></view></view>

    <view class="card"><text class="card-title">订单流程时间轴</text><view wx:for="{{stages}}" wx:key="key" class="flow-stage {{item.active?'active':''}}"><view class="flow-dot"></view><view><text>{{item.title}}</text><text>{{item.time || (item.active ? '已进入该阶段' : '尚未进入')}}</text></view></view></view>
    <view class="card"><text class="card-title">联系记录</text><view wx:for="{{task.contacts}}" wx:key="id" class="record"><text>{{item.result==='CONTACT_SUCCESS'?'联系成功':'联系失败'}} · {{item.contactedAt}}</text><text>{{item.failureReason || item.remark || '无备注'}}</text></view><text wx:if="{{!task.contacts.length}}" class="hint">暂无业务员联系记录</text></view>
    <view class="card"><text class="card-title">订单流转记录</text><view wx:for="{{task.history}}" wx:key="id" class="timeline"><view class="timeline-dot"></view><view><text>{{item.oldStatusText}} → {{item.newStatusText}}</text><text>{{item.operatorName}} · {{item.createdAt}}</text><text wx:if="{{item.remark}}">{{item.remark}}</text></view></view><text wx:if="{{!task.history.length}}" class="hint">暂无流转记录</text></view>
  </block>
</view>

.transfer-card{margin-top:20rpx;padding:26rpx;border:2rpx solid #f1d0b3;border-radius:22rpx;background:#fff}.head{display:flex;justify-content:space-between;color:#2d4156;font-size:26rpx;font-weight:700}.head text:last-child{padding:6rpx 12rpx;border-radius:18rpx;background:#fff1e4;color:#d06b18;font-size:18rpx}.row{padding:14rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #edf0f4;color:#8491a1;font-size:21rpx}.row text:last-child{color:#40546a}.reason{margin-top:16rpx;color:#5d7084;font-size:21rpx;line-height:1.55}.actions{margin-top:18rpx;display:flex;gap:12rpx}.actions button{flex:1;margin:0;border-radius:12rpx;background:#f1f3f5;color:#66778a;font-size:22rpx}.actions .accept{background:#d06b18;color:#fff}.actions button::after{border:0}

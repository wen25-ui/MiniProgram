<view class="page">
  <view class="sticky-filter">
    <view class="hero"><text class="title">审核与订单流程</text><text class="desc">查看申请审核、派单和处理状态</text></view>
    <scroll-view class="filters" scroll-x="true"><view class="filter-row"><view wx:for="{{filters}}" wx:key="key" class="filter {{status===item.key?'active':''}}" data-status="{{item.key}}" bindtap="chooseStatus">{{item.label}}</view></view></scroll-view>
  </view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <view wx:if="{{loading}}" class="empty">正在读取订单…</view>
  <view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openDetail"><view class="head"><text class="phone">{{item.maskedPhone}}</text><text class="status">{{item.statusText}}</text></view><text class="id">{{item.id}}</text><view class="row"><text>办理方式</text><text>{{item.serviceMode==='HOME_SERVICE'?'上门办理':item.serviceMode==='STORE_SERVICE'?'线下网点':'待确认'}}</text></view><view class="row"><text>分配对象</text><text>{{item.handlerName||item.assignedStoreName||'待分配'}}</text></view><view class="row"><text>最近更新</text><text>{{item.updatedAt}}</text></view></view>
  <view wx:if="{{!loading&&!orders.length}}" class="empty">当前筛选下暂无订单</view>
  <role-bottom-nav role="admin" current="orders"></role-bottom-nav>
</view>

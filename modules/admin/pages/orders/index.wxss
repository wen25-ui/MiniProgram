.page{min-height:100vh;padding:28rpx 28rpx 150rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:32rpx;border-radius:24rpx;background:linear-gradient(135deg,#234b91,#557bd0);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.9}.filters{margin:20rpx 0;white-space:nowrap}.filter-row{display:flex;gap:12rpx}.filter{padding:14rpx 22rpx;border-radius:30rpx;background:#fff;color:#66778b;font-size:22rpx}.filter.active{background:#2457c5;color:#fff}.card{margin-bottom:18rpx;padding:26rpx;border-radius:20rpx;background:#fff}.head,.row{display:flex;align-items:center;justify-content:space-between}.phone{font-size:28rpx;font-weight:700;color:#253a52}.status{padding:8rpx 15rpx;border-radius:20rpx;background:#e9f0ff;color:#2457c5;font-size:20rpx}.id{display:block;margin:8rpx 0 12rpx;color:#9aa6b4;font-size:18rpx}.row{min-height:58rpx;border-top:1rpx solid #f0f2f5;color:#7b8998;font-size:21rpx}.row text:last-child{color:#40536a}.empty{padding:80rpx 20rpx;background:#fff;border-radius:20rpx;color:#8b98a7;text-align:center}.message{display:block;margin-bottom:16rpx;color:#b54708}

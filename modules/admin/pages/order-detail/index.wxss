.page{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:32rpx;border-radius:24rpx;background:linear-gradient(135deg,#234b91,#557bd0);color:#fff}.eyebrow{font-size:21rpx;opacity:.85}.title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.id{display:block;margin-top:10rpx;font-size:18rpx;opacity:.78}.card{margin-top:20rpx;padding:26rpx;border-radius:20rpx;background:#fff}.card-title{padding-bottom:18rpx;border-bottom:1rpx solid #edf1f5;color:#253a52;font-size:28rpx;font-weight:700}.row{min-height:68rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f1f3f6;color:#7b8998;font-size:22rpx}.row text:last-child{max-width:420rpx;color:#40536a;text-align:right}.timeline{position:relative;padding:22rpx 0 22rpx 36rpx;border-left:2rpx solid #dce6f8}.dot{position:absolute;left:-9rpx;top:28rpx;width:16rpx;height:16rpx;border-radius:50%;background:#2457c5}.content text{display:block}.change{color:#2e435b;font-size:24rpx;font-weight:700}.action{margin-top:8rpx;color:#65778c;font-size:21rpx}.operator{margin-top:8rpx;color:#9aa6b3;font-size:19rpx}.empty{padding:80rpx 20rpx;border-radius:20rpx;background:#fff;color:#8b98a7;text-align:center}.empty.error{color:#b54708}

<view class="page"><view wx:if="{{loading}}" class="empty">正在读取订单详情…</view><view wx:elif="{{message}}" class="empty error">{{message}}</view><block wx:elif="{{order}}"><view class="hero"><text class="eyebrow">当前状态</text><text class="title">{{order.statusText}}</text><text class="id">{{order.id}}</text></view><view class="card"><view class="card-title">订单信息</view><view class="row"><text>客户手机号</text><text>{{order.phone}}</text></view><view class="row"><text>办理方式</text><text>{{order.serviceMode==='HOME_SERVICE'?'上门办理':order.serviceMode==='STORE_SERVICE'?'线下网点':'待确认'}}</text></view><view class="row"><text>真实性结果</text><text>{{order.verifyResult==='VERIFIED'?'信息属实':order.verifyResult==='INVALID_INFO'?'信息异常':'待核实'}}</text></view><view class="row"><text>客户意愿</text><text>{{order.customerIntention==='WILLING'?'愿意办理':order.customerIntention==='UNWILLING'?'不办理':'待确认'}}</text></view><view class="row"><text>分配人员/网点</text><text>{{order.handlerName||order.assignedStoreName||'待分配'}}</text></view></view><view class="card"><view class="card-title">订单流转记录</view><view wx:for="{{order.history}}" wx:key="id" class="timeline"><view class="dot"></view><view class="content"><text class="change">{{item.fromStatusText}} → {{item.toStatusText}}</text><text class="action">{{item.actionCode}}{{item.reason?' · '+item.reason:''}}</text><text class="operator">{{item.operatorName}}（{{item.operatorRole}}） · {{item.createdAt}}</text></view></view><view wx:if="{{!order.history.length}}" class="empty">暂无流转记录</view></view></block></view>

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.header{padding:32rpx;border-radius:26rpx;background:linear-gradient(135deg,#1677c8,#55b9e9);color:#fff}.title{display:block;font-size:36rpx;font-weight:700}.desc{display:block;margin-top:10rpx;font-size:22rpx;opacity:.88}.message{display:block;margin-top:18rpx;color:#b54708}.card{margin-top:20rpx;padding:28rpx;border-radius:24rpx;background:#fff}.head,.row{display:flex;justify-content:space-between;align-items:center}.phone{color:#26394e;font-size:29rpx;font-weight:700}.status{padding:8rpx 15rpx;border-radius:24rpx;background:#e8f5ff;color:#1677c8;font-size:21rpx}.description{display:block;margin:20rpx 0;color:#68798b;font-size:23rpx;line-height:1.5}.row{min-height:62rpx;border-top:1rpx solid #edf0f4;color:#8793a2;font-size:22rpx}.row text:last-child{max-width:430rpx;color:#405368;text-align:right}.time{display:block;margin-top:14rpx;color:#a1abb7;font-size:19rpx;text-align:right}.empty{margin-top:20rpx;padding:80rpx;border-radius:24rpx;background:#fff;color:#909ba8;text-align:center}

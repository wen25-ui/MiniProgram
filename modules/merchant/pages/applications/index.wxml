<view class="page"><view class="header"><text class="title">归属客户申请</text><text class="desc">仅展示通过本门店推广入口归属的客户</text></view><text wx:if="{{message}}" class="message">{{message}}</text><view wx:for="{{applications}}" wx:key="id" class="card"><view class="head"><text class="phone">{{item.maskedPhone}}</text><text class="status">{{item.statusText}}</text></view><text class="description">{{item.statusDescription}}</text><view class="row"><text>申请编号</text><text>{{item.id}}</text></view><view class="row"><text>话费档位</text><text>{{item.expenseTier || '未填写'}}</text></view><view class="row"><text>预约时间</text><text>{{item.appointmentTime || '待确认'}}</text></view><text class="time">最近更新 {{item.updatedAt}}</text></view><view wx:if="{{!loading&&!applications.length}}" class="empty">暂无归属客户申请</view><role-bottom-nav role="merchant" current="applications"></role-bottom-nav></view>

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:36rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#1677c8,#55b9e9);color:#fff;box-shadow:0 14rpx 32rpx rgba(22,119,200,.18)}.eyebrow{display:block;font-size:23rpx;opacity:.86}.hero-title{display:block;margin-top:8rpx;font-size:38rpx;font-weight:700}.hero-desc{display:block;margin-top:12rpx;font-size:22rpx;opacity:.86}.hero-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.18);font-size:36rpx;font-weight:700}.message{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#fff2df;color:#b54708;font-size:23rpx}.stats-grid{margin-top:22rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.stat-card{padding:26rpx;border-radius:22rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(27,53,82,.05)}.stat-value{display:block;color:#26384c;font-size:38rpx;font-weight:700}.stat-value.blue{color:#1677c8}.stat-value.green{color:#168960}.stat-value.orange{color:#d78012}.stat-label{display:block;margin-top:7rpx;color:#8d99a8;font-size:22rpx}.quick-row{margin-top:22rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.quick-card{padding:24rpx 20rpx;display:flex;align-items:center;border-radius:22rpx;background:#fff}.quick-icon{width:62rpx;height:62rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:17rpx;font-weight:700}.qr{background:#e8f5ff;color:#1677c8}.customer{background:#e8f8f1;color:#168960}.quick-title{display:block;color:#2c3e52;font-size:25rpx;font-weight:600}.quick-desc{display:block;margin-top:5rpx;color:#98a3b1;font-size:18rpx}.section-head{margin:32rpx 6rpx 16rpx;display:flex;justify-content:space-between;align-items:center}.section-head text:first-child{color:#17283c;font-size:31rpx;font-weight:700}.section-head text:last-child{color:#1677c8;font-size:22rpx}.list-card{padding:0 26rpx;border-radius:24rpx;background:#fff}.application-row{min-height:112rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.application-row:last-child{border-bottom:0}.avatar{width:54rpx;height:54rpx;margin-right:16rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:#eaf5fb;color:#1677c8;font-size:22rpx}.application-main{min-width:0;flex:1}.phone{display:block;color:#304358;font-size:25rpx;font-weight:600}.id{display:block;margin-top:5rpx;overflow:hidden;text-overflow:ellipsis;color:#9aa5b2;font-size:18rpx;white-space:nowrap}.application-side{text-align:right}.status{display:block;color:#1677c8;font-size:22rpx}.time{display:block;margin-top:5rpx;color:#a3adba;font-size:17rpx}.empty{padding:70rpx 30rpx;border-radius:24rpx;background:#fff;color:#8e9aa9;font-size:24rpx;text-align:center}
.qr-mask{position:fixed;z-index:1000;top:0;right:0;bottom:0;left:0;padding:40rpx;display:flex;align-items:center;justify-content:center;background:rgba(8,20,34,.62)}.qr-dialog{width:100%;padding:38rpx;box-sizing:border-box;border-radius:30rpx;background:#fff;text-align:center}.qr-dialog-title{display:block;color:#1d334b;font-size:34rpx;font-weight:700}.qr-dialog-desc{display:block;margin-top:12rpx;color:#738194;font-size:22rpx;line-height:1.5}.qr-loading{margin:42rpx 0;padding:90rpx 0;border-radius:20rpx;background:#f5f7fa;color:#8c98a6;font-size:24rpx}.qr-image{width:480rpx;height:480rpx;margin:26rpx auto 0;display:block}.invite-code{display:block;margin-top:14rpx;color:#40556d;font-size:21rpx;word-break:break-all}.qr-tip{display:block;margin-top:16rpx;color:#9a6a22;font-size:20rpx;line-height:1.5}.qr-close{margin-top:26rpx;border-radius:16rpx;background:#1677c8;color:#fff;font-size:25rpx}.qr-close::after{border:0}

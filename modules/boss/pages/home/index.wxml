<view class="page"><view class="hero"><view><text class="eyebrow">BOSS 经营驾驶舱</text><text class="hero-title">全局业务概览</text><text class="hero-desc">业务规模、履约进度与账务数据实时汇总</text></view><view class="hero-icon">总</view></view><text wx:if="{{message}}" class="message">{{message}}</text><view class="main-metrics"><view><text class="metric-label">累计申请</text><text class="metric-value">{{stats.total_applications || 0}}</text><text class="metric-note">全渠道业务规模</text></view><view><text class="metric-label">完成业务</text><text class="metric-value green">{{stats.completed || 0}}</text><text class="metric-note">客服核销通过</text></view></view><view class="stats-grid"><view class="stat"><text>{{stats.processing || 0}}</text><text>处理中</text></view><view class="stat"><text>{{stats.withdrawn || 0}}</text><text>已撤回</text></view><view class="stat"><text>{{stats.active_merchants || 0}}</text><text>活跃门店</text></view><view class="stat"><text>¥{{stats.commission_total || 0}}</text><text>佣金账面</text></view></view><view class="section-head"><text>经营数据</text><text>全局只读汇总</text></view><view class="finance-card"><view><text>客户返现账面总额</text><text>¥{{stats.cashback_total || 0}}</text></view><view class="divider"></view><view><text>商家佣金账面总额</text><text>¥{{stats.commission_total || 0}}</text></view></view><view class="section-head"><text>人员与角色</text><text>当前账号数量</text></view><view class="role-grid"><view><text class="role-icon merchant">商</text><text>商家</text><text>{{roles.merchant || 0}}</text></view><view><text class="role-icon service">服</text><text>客服</text><text>{{roles['customer-service'] || 0}}</text></view><view><text class="role-icon salesman">业</text><text>业务员</text><text>{{roles.salesman || 0}}</text></view><view><text class="role-icon finance">财</text><text>财务</text><text>{{roles.finance || 0}}</text></view></view><view class="action-grid"><view data-name="人员管理" bindtap="showPending"><text class="action-icon">人</text><view><text>人员管理</text><text>角色与权限配置</text></view></view><view data-name="数据导出" bindtap="showPending"><text class="action-icon export">出</text><view><text>数据导出</text><text>经营报表与明细</text></view></view></view><view class="section-head"><text>最近业务动态</text><text>按更新时间排序</text></view><view wx:if="{{applications.length}}" class="list"><view wx:for="{{applications}}" wx:key="id" class="row"><view class="avatar">{{index+1}}</view><view class="main"><text>{{item.merchantName}}</text><text>{{item.id}}</text></view><view class="side"><text>{{item.statusText}}</text><text>{{item.updatedAt}}</text></view></view></view><view wx:else class="empty">暂无业务数据</view><role-bottom-nav role="boss" current="home"></role-bottom-nav></view>

.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.hero{padding:38rpx;display:flex;align-items:center;justify-content:space-between;border-radius:30rpx;background:linear-gradient(135deg,#172b4d,#365780);color:#fff;box-shadow:0 14rpx 32rpx rgba(23,43,77,.2)}.eyebrow{display:block;color:#a9c9ea;font-size:23rpx}.hero-title{display:block;margin-top:8rpx;font-size:40rpx;font-weight:700}.hero-desc{display:block;margin-top:12rpx;font-size:22rpx;opacity:.82}.hero-icon{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:rgba(255,255,255,.14);font-size:36rpx;font-weight:700}.message{display:block;margin-top:18rpx;color:#b54708}.main-metrics{margin-top:22rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.main-metrics>view{padding:28rpx;border-radius:23rpx;background:#fff}.metric-label{display:block;color:#8b97a6;font-size:21rpx}.metric-value{display:block;margin-top:8rpx;color:#172b4d;font-size:42rpx;font-weight:750}.metric-value.green{color:#168960}.metric-note{display:block;margin-top:7rpx;color:#a2acb8;font-size:18rpx}.stats-grid{margin-top:16rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.stat{padding:22rpx;display:flex;align-items:center;justify-content:space-between;border-radius:20rpx;background:#fff}.stat text:first-child{color:#365780;font-size:28rpx;font-weight:700}.stat text:last-child{color:#8e9aa8;font-size:21rpx}.section-head{margin:32rpx 6rpx 16rpx;display:flex;justify-content:space-between;align-items:baseline}.section-head text:first-child{color:#17283c;font-size:31rpx;font-weight:700}.section-head text:last-child{color:#9ba5b2;font-size:20rpx}.finance-card{padding:28rpx;display:flex;border-radius:23rpx;background:#fff}.finance-card>view{flex:1;display:flex;flex-direction:column;color:#8e99a7;font-size:20rpx}.finance-card>view text:last-child{margin-top:8rpx;color:#d27a12;font-size:30rpx;font-weight:700}.finance-card .divider{max-width:1rpx;margin:0 24rpx;background:#e7ebf0}.role-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.role-grid>view{padding:20rpx;display:flex;align-items:center;border-radius:20rpx;background:#fff;color:#536579;font-size:23rpx}.role-grid>view>text:last-child{margin-left:auto;color:#26394e;font-size:27rpx;font-weight:700}.role-icon{width:50rpx;height:50rpx;margin-right:13rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;font-size:21rpx;font-weight:700}.merchant{background:#e8f5ff;color:#1677c8}.service{background:#e7f7f5;color:#0f7f89}.salesman{background:#fff1e4;color:#d06b18}.finance{background:#eef0ff;color:#3756c7}.action-grid{margin-top:18rpx;display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.action-grid>view{padding:23rpx;display:flex;align-items:center;border-radius:20rpx;background:#fff}.action-icon{width:55rpx;height:55rpx;margin-right:14rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#eaf1f8;color:#365780;font-weight:700}.action-icon.export{background:#edf7ef;color:#168960}.action-grid view view text:first-child{display:block;color:#33475c;font-size:23rpx;font-weight:600}.action-grid view view text:last-child{display:block;margin-top:4rpx;color:#9ba5b2;font-size:18rpx}.list{padding:0 25rpx;border-radius:24rpx;background:#fff}.row{min-height:104rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.row:last-child{border-bottom:0}.avatar{width:52rpx;height:52rpx;margin-right:15rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:#eaf1f8;color:#365780}.main{min-width:0;flex:1}.main text:first-child{display:block;color:#314459;font-size:23rpx;font-weight:600}.main text:last-child{display:block;margin-top:4rpx;overflow:hidden;text-overflow:ellipsis;color:#a0aab7;font-size:18rpx;white-space:nowrap}.side{text-align:right}.side text:first-child{display:block;color:#365780;font-size:21rpx}.side text:last-child{display:block;margin-top:4rpx;color:#a3adba;font-size:17rpx}.empty{padding:70rpx;border-radius:24rpx;background:#fff;color:#929dab;text-align:center}

.voucher {
  margin-top: 20rpx;
  min-height: 180rpx;
  border: 1rpx dashed #cfd7e4;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  overflow: hidden;
}

.voucher image {
  width: 100%;
  height: 260rpx;
}

.voucher text {
  position: absolute;
  padding: 8rpx 18rpx;
  background: rgba(16, 32, 51, 0.72);
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.empty-voucher {
  height: 180rpx;
}

.choose {
  margin-top: 20rpx;
}

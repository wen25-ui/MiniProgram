<view class="page">
  <view class="section">
    <view class="title">{{salesman.name}}的订单</view>
    <view class="subtitle">查看已指派订单，完成接单、上门办理和凭证提交。</view>
  </view>

  <view wx:if="{{loading}}" class="panel muted">加载中...</view>
  <view wx:elif="{{orders.length}}" class="list-gap">
    <order-card wx:for="{{orders}}" wx:key="id" order="{{item}}" bind:taporder="openDetail"></order-card>
  </view>
  <empty-state wx:else title="暂无待办订单" desc="管理员派单后会出现在这里"></empty-state>
</view>

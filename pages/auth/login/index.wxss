.page{min-height:100vh;padding:36rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:linear-gradient(180deg,#eaf4ff 0,#f5f8fc 46%,#f7f9fc 100%)}.brand-panel{position:relative;min-height:250rpx;padding:42rpx 36rpx;display:flex;align-items:center;overflow:hidden;border-radius:34rpx;background:linear-gradient(135deg,#102845 0,#20548a 64%,#2f73ad 100%);box-sizing:border-box;color:#fff;box-shadow:0 18rpx 42rpx rgba(25,65,105,.2)}.brand-mark{position:relative;z-index:2;width:92rpx;height:92rpx;margin-right:25rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.24);border-radius:28rpx;background:rgba(255,255,255,.13);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.22)}.brand-ring{width:48rpx;height:48rpx;border:6rpx solid rgba(255,255,255,.9);border-radius:50%;box-sizing:border-box}.brand-core{position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:#78d7ff}.brand-copy{position:relative;z-index:2;flex:1}.brand-eyebrow,.brand-title,.brand-desc{display:block}.brand-eyebrow{font-size:17rpx;letter-spacing:3rpx;opacity:.62}.brand-title{margin-top:10rpx;font-size:36rpx;font-weight:800;letter-spacing:1rpx}.brand-desc{margin-top:12rpx;font-size:21rpx;opacity:.72}.brand-orb{position:absolute;border-radius:50%;background:rgba(117,205,255,.12)}.orb-one{width:230rpx;height:230rpx;right:-76rpx;top:-90rpx}.orb-two{width:120rpx;height:120rpx;right:110rpx;bottom:-70rpx}.card{position:relative;margin:-25rpx 20rpx 0;padding:42rpx 34rpx 34rpx;border:1rpx solid rgba(226,233,242,.9);border-radius:30rpx;background:rgba(255,255,255,.98);box-shadow:0 16rpx 46rpx rgba(25,53,83,.11)}.card-head{display:flex;align-items:flex-start;justify-content:space-between}.welcome,.subtitle{display:block}.welcome{color:#172d47;font-size:38rpx;font-weight:800}.subtitle{margin-top:8rpx;color:#8b98a8;font-size:22rpx}.scan{width:112rpx;height:64rpx;margin:0;padding:0 16rpx;display:flex;align-items:center;justify-content:center;border-radius:32rpx;background:#edf4ff;color:#245f9d;font-size:20rpx;line-height:64rpx}.scan::after{border:0}.camera-icon{position:relative;width:31rpx;height:24rpx;margin-right:9rpx;border:3rpx solid currentColor;border-radius:5rpx;box-sizing:border-box}.camera-icon::before{content:'';position:absolute;left:5rpx;top:-7rpx;width:14rpx;height:6rpx;border-radius:3rpx 3rpx 0 0;background:currentColor}.camera-lens{position:absolute;left:50%;top:50%;width:9rpx;height:9rpx;border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box;transform:translate(-50%,-50%)}.field{margin-top:30rpx}.field-label{display:block;margin:0 0 11rpx 4rpx;color:#41566e;font-size:22rpx;font-weight:650}.input-shell{height:88rpx;padding:0 20rpx;display:flex;align-items:center;border:2rpx solid #e0e7ef;border-radius:17rpx;background:#f8fafc;box-sizing:border-box;transition:border-color .2s,background .2s}.input{flex:1;height:84rpx;margin-left:17rpx;padding:0;border:0;background:transparent;color:#21384f;font-size:25rpx}.placeholder{color:#a7b1bd}.input-icon{position:relative;width:32rpx;height:32rpx;box-sizing:border-box;color:#71859a}.phone-icon{border:3rpx solid currentColor;border-radius:8rpx}.phone-icon::after{content:'';position:absolute;left:8rpx;right:8rpx;bottom:4rpx;height:2rpx;border-radius:2rpx;background:currentColor}.lock-icon{height:25rpx;margin-top:7rpx;border:3rpx solid currentColor;border-radius:7rpx}.lock-loop{position:absolute;left:5rpx;top:-14rpx;width:16rpx;height:15rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:9rpx 9rpx 0 0;box-sizing:border-box}.message{margin-top:22rpx;padding:16rpx 18rpx;display:flex;align-items:center;border-radius:13rpx;background:#fff5e9;color:#a9630a;font-size:21rpx;line-height:1.45}.message-dot{width:10rpx;height:10rpx;margin-right:12rpx;flex-shrink:0;border-radius:50%;background:#e89a32}.login-button{height:88rpx;margin-top:30rpx;border-radius:18rpx;background:linear-gradient(135deg,#1d5fa2,#2e7ac0);color:#fff;font-size:28rpx;font-weight:750;line-height:88rpx;box-shadow:0 12rpx 24rpx rgba(31,103,170,.22)}.login-button::after{border:0}.login-button[disabled]{background:linear-gradient(135deg,#7ba7ce,#96bddc);color:rgba(255,255,255,.9)}.register-entry{margin-top:26rpx;display:flex;justify-content:center;color:#8996a5;font-size:22rpx}.register-link{margin-left:10rpx;color:#1f68ac;font-weight:700}.trust-row{margin-top:32rpx;display:flex;align-items:center;justify-content:center;color:#98a5b3;font-size:19rpx}.trust-row>view:not(.trust-divider){display:flex;align-items:center}.trust-icon{width:30rpx;height:30rpx;margin-right:8rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#e5f3ec;color:#27825b;font-size:15rpx;font-weight:700}.trust-divider{width:1rpx;height:24rpx;margin:0 28rpx;background:#d9e1ea}.login-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;padding:30rpx;display:flex;align-items:center;justify-content:center;background:rgba(12,29,49,.55);padding:52rpx 42rpx 40rpx;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;border-radius:30rpx;background:#fff;box-shadow:0 24rpx 70rpx rgba(7,27,48,.28)}.login-spinner{width:68rpx;height:68rpx;border:7rpx solid #dceafa;border-top-color:#246bae;border-radius:50%;animation:login-spin .8s linear infinite}.login-dialog-title{margin-top:27rpx;color:#172f4a;font-size:33rpx;font-weight:800}.login-dialog-status{margin-top:13rpx;color:#76879a;font-size:23rpx}.progress-track{width:100%;height:11rpx;margin-top:31rpx;overflow:hidden;border-radius:8rpx;background:#e7edf3}.progress-value{height:100%;border-radius:8rpx;background:linear-gradient(90deg,#1f65a8,#55b8e8);transition:width .25s ease}.progress-text{margin-top:12rpx;color:#246bae;font-size:21rpx}@keyframes login-spin{to{transform:rotate(360deg)}}

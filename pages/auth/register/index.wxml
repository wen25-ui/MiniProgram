<view class="page">
  <view class="brand-panel">
    <view class="brand-mark"><view class="brand-ring"></view><view class="brand-core"></view></view>
    <view><text class="brand-eyebrow">CLIENT ONBOARDING</text><text class="brand-title">创建客户账号</text><text class="brand-desc">完成注册后即可提交业务办理申请</text></view>
  </view>
  <view class="card">
    <view class="card-head"><view><text class="title">注册账号</text><text class="subtitle">请填写真实有效的手机号码</text></view><view class="step-badge">客户注册</view></view>

    <text class="label">手机号码</text>
    <input class="input" type="number" maxlength="11" placeholder="请输入手机号码" placeholder-class="placeholder" bindinput="onPhoneInput"/>

    <text class="label">图形验证码</text>
    <view class="field-row"><input class="row-input" type="number" maxlength="4" value="{{captcha}}" placeholder="请输入图形验证码" placeholder-class="placeholder" bindinput="onCaptchaInput"/><view class="captcha" bindtap="refreshCaptcha">{{captchaText}}</view></view>

    <text class="label">短信验证码</text>
    <view class="field-row"><input class="row-input" type="number" maxlength="6" placeholder="请输入短信验证码" placeholder-class="placeholder" bindinput="onSmsCodeInput"/><button class="code-button" bindtap="sendSmsCode">获取验证码</button></view>

    <text class="label">设置密码</text>
    <input class="input" password maxlength="32" placeholder="至少 6 位字符" placeholder-class="placeholder" bindinput="onPasswordInput"/>
    <input class="input confirm-input" password maxlength="32" placeholder="请再次输入密码" placeholder-class="placeholder" bindinput="onConfirmPasswordInput"/>

    <view wx:if="{{message}}" class="message"><view class="message-dot"></view><text>{{message}}</text></view>
    <button class="register-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRegister">{{submitting?'正在注册…':'注册并进入系统'}}</button>
    <navigator class="login-entry" url="/pages/auth/login/index" open-type="redirect"><text>已有账号？</text><text>返回登录</text></navigator>
  </view>
</view>

.page{min-height:100vh;padding:36rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:linear-gradient(180deg,#eaf4ff 0,#f5f8fc 46%,#f7f9fc 100%)}.brand-panel{min-height:190rpx;padding:34rpx 36rpx 52rpx;display:flex;align-items:center;border-radius:34rpx;background:linear-gradient(135deg,#102845,#20548a 64%,#2f73ad);box-sizing:border-box;color:#fff;box-shadow:0 18rpx 42rpx rgba(25,65,105,.2)}.brand-mark{position:relative;width:78rpx;height:78rpx;margin-right:22rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.24);border-radius:24rpx;background:rgba(255,255,255,.13)}.brand-ring{width:42rpx;height:42rpx;border:5rpx solid rgba(255,255,255,.9);border-radius:50%;box-sizing:border-box}.brand-core{position:absolute;width:14rpx;height:14rpx;border-radius:50%;background:#78d7ff}.brand-eyebrow,.brand-title,.brand-desc{display:block}.brand-eyebrow{font-size:16rpx;letter-spacing:2rpx;opacity:.6}.brand-title{margin-top:7rpx;font-size:32rpx;font-weight:800}.brand-desc{margin-top:8rpx;font-size:19rpx;opacity:.72}.card{position:relative;margin:-26rpx 20rpx 0;padding:38rpx 34rpx 34rpx;border:1rpx solid #e4eaf2;border-radius:30rpx;background:#fff;box-shadow:0 16rpx 46rpx rgba(25,53,83,.1)}.card-head{margin-bottom:27rpx;display:flex;align-items:flex-start;justify-content:space-between}.title,.subtitle{display:block}.title{color:#172d47;font-size:36rpx;font-weight:800}.subtitle{margin-top:7rpx;color:#8b98a8;font-size:21rpx}.step-badge{padding:8rpx 14rpx;border-radius:18rpx;background:#edf4ff;color:#245f9d;font-size:18rpx}.label{display:block;margin:21rpx 0 10rpx 4rpx;color:#41566e;font-size:22rpx;font-weight:650}.input,.row-input{height:84rpx;min-height:84rpx;padding:0 21rpx;border:2rpx solid #e0e7ef;border-radius:16rpx;background:#f8fafc;box-sizing:border-box;color:#21384f;font-size:24rpx}.input{margin-bottom:0}.confirm-input{margin-top:15rpx}.field-row{display:flex;gap:14rpx}.row-input{flex:1;width:0}.placeholder{color:#a7b1bd}.captcha,.code-button{width:190rpx;height:84rpx;margin:0;flex:none;border-radius:16rpx;background:#edf4ff;color:#245f9d}.captcha{display:flex;align-items:center;justify-content:center;font-size:31rpx;font-weight:800;letter-spacing:7rpx}.code-button{padding:0 10rpx;font-size:22rpx;line-height:84rpx}.code-button::after{border:0}.message{margin-top:20rpx;padding:15rpx 18rpx;display:flex;align-items:center;border-radius:13rpx;background:#fff5e9;color:#a9630a;font-size:21rpx}.message-dot{width:10rpx;height:10rpx;margin-right:11rpx;border-radius:50%;background:#e89a32}.register-button{height:88rpx;margin-top:29rpx;border-radius:18rpx;background:linear-gradient(135deg,#1d5fa2,#2e7ac0);color:#fff;font-size:27rpx;font-weight:750;line-height:88rpx;box-shadow:0 12rpx 24rpx rgba(31,103,170,.2)}.register-button::after{border:0}.register-button[disabled]{background:#8bb2d2;color:rgba(255,255,255,.9)}.login-entry{margin-top:25rpx;display:flex;justify-content:center;color:#8996a5;font-size:22rpx}.login-entry text:last-child{margin-left:10rpx;color:#1f68ac;font-weight:700}

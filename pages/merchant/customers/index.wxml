<view class="page">
  <view class="section">
    <view class="title">客户列表</view>
    <view class="subtitle">本页只展示当前门店推荐客户。</view>
  </view>
  <view wx:if="{{loading}}" class="panel muted">加载中...</view>
  <view wx:elif="{{orders.length}}" class="list-gap">
    <order-card wx:for="{{orders}}" wx:key="id" order="{{item}}" showSalesman="{{true}}" bind:taporder="openDetail"></order-card>
  </view>
  <empty-state wx:else title="暂无客户" desc="客户提交申请后同步到门店"></empty-state>
</view>

<view class="page" wx:if="{{order}}">
  <order-card class="section" order="{{order}}" showSalesman="{{true}}"></order-card>

  <view class="grid-2 section">
    <money-card label="预计佣金" amount="{{order.expectedCommissionText}}" note="返费 10%"></money-card>
    <money-card label="已锁定佣金" amount="{{order.lockedCommissionText}}" note="{{order.commissionStatus}}"></money-card>
  </view>

  <view class="panel section">
    <view class="row"><text class="muted">办理进度</text><status-tag status="{{order.status}}"></status-tag></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">业务员</text><text>{{order.salesmanName || '未指派'}}</text></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">预约时间</text><text>{{order.appointmentTime}}</text></view>
  </view>

  <view class="panel">
    <view class="strong">进度记录</view>
    <view wx:for="{{order.timeline}}" wx:key="time" class="timeline">
      <status-tag status="{{item.status}}"></status-tag>
      <view class="timeline-body">
        <view>{{item.text}}</view>
        <view class="muted">{{item.time}}</view>
      </view>
    </view>
  </view>
</view>

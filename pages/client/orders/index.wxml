<view class="page">
  <view class="section">
    <view class="title">订单进度</view>
    <view class="subtitle">手机号已脱敏显示，进度会随管理员和业务员操作同步更新。</view>
  </view>

  <view wx:if="{{loading}}" class="panel muted">加载中...</view>
  <order-card wx:elif="{{order}}" order="{{order}}" bind:taporder="openDetail"></order-card>
  <empty-state wx:else title="暂无订单" desc="提交申请后可在这里查看"></empty-state>
</view>

<view class="page">
  <view class="section">
    <view class="title">预约资料</view>
    <view class="subtitle">提交后订单进入待审核，管理员端可进行人工审核。</view>
  </view>

  <view class="panel">
    <view class="field">
      <text class="label">姓名</text>
      <input value="{{customerName}}" data-field="customerName" bindinput="onInput" placeholder="请输入姓名" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" />
    </view>
    <view class="field">
      <text class="label">地址</text>
      <input value="{{address}}" data-field="address" bindinput="onInput" placeholder="请输入上门地址" />
    </view>
    <view class="field">
      <text class="label">预约日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view class="picker-text">{{date}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">预约时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTime">
        <view class="picker-text">{{time}}</view>
      </picker>
    </view>
  </view>

  <view class="fixed-spacer"></view>
  <view class="fixed-actions">
    <button class="btn" loading="{{submitting}}" bindtap="submit">提交申请</button>
  </view>
</view>

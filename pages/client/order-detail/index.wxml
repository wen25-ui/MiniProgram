<view class="page" wx:if="{{order}}">
  <order-card class="section" order="{{order}}"></order-card>

  <view class="panel section">
    <view class="row"><text class="muted">客户姓名</text><text>{{order.customerName}}</text></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">手机号</text><text>{{order.maskedPhone}}</text></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">上门地址</text><text>{{order.address}}</text></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">预约时间</text><text>{{order.appointmentTime}}</text></view>
    <view wx:if="{{order.rejectReason}}" class="divider"></view>
    <view wx:if="{{order.rejectReason}}" class="row"><text class="muted">驳回原因</text><text>{{order.rejectReason}}</text></view>
  </view>

  <view class="panel">
    <view class="strong">办理进度</view>
    <view wx:for="{{order.timeline}}" wx:key="time" class="timeline">
      <status-tag status="{{item.status}}"></status-tag>
      <view class="timeline-body">
        <view>{{item.text}}</view>
        <view class="muted">{{item.time}}</view>
      </view>
    </view>
  </view>
</view>

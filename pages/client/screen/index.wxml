<view class="page">
  <view class="section">
    <view class="title">4 项初筛信息</view>
    <view class="subtitle">四项全部满足才可进入资料补充；任一不满足则初筛不通过。</view>
  </view>

  <view class="panel">
    <view class="field">
      <text class="label">本机手机号</text>
      <input type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="请输入 11 位手机号" />
    </view>
    <view class="field">
      <text class="label">本地常住、本地号码、可办本地卡</text>
      <picker range="{{localOptions}}" value="{{localIndex}}" bindchange="onLocal">
        <view class="picker-text">{{localOptions[localIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">全家每月话费档位</text>
      <picker range="{{packageOptions}}" value="{{packageIndex}}" bindchange="onPackage">
        <view class="picker-text">{{packageOptions[packageIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">是否接受 3 年不销户、不转网、不能降低套餐</text>
      <picker range="{{acceptOptions}}" value="{{acceptIndex}}" bindchange="onAccept">
        <view class="picker-text">{{acceptOptions[acceptIndex]}}</view>
      </picker>
    </view>
  </view>

  <view class="fixed-spacer"></view>
  <view class="fixed-actions">
    <button class="btn" bindtap="submit">查看初筛结果</button>
  </view>
</view>

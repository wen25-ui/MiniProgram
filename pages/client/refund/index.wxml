<view class="page" wx:if="{{order}}">
  <view class="section">
    <view class="title">返费状态</view>
    <view class="subtitle">核销成功后生成客户返费，管理员标记后更新为已退费。</view>
  </view>

  <view class="grid-2 section">
    <money-card label="预计返费" amount="{{order.expectedRefundText}}" note="以公司核销为准"></money-card>
    <money-card label="退费状态" amount="{{order.refundStatus}}" note="{{order.statusLabel}}"></money-card>
  </view>

  <view class="panel">
    <view class="row"><text class="muted">订单号</text><text>{{order.id}}</text></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">当前进度</text><status-tag status="{{order.status}}"></status-tag></view>
    <view class="divider"></view>
    <view class="row"><text class="muted">手机号</text><text>{{order.maskedPhone}}</text></view>
  </view>
</view>

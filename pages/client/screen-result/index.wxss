.result {
  padding: 42rpx 28rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.pass {
  background: #e8f7ef;
  color: #16733f;
}

.fail {
  background: #fdecea;
  color: #b3261e;
}

.result-title {
  font-size: 42rpx;
  font-weight: 800;
}

.result-desc {
  margin-top: 12rpx;
  line-height: 1.6;
}

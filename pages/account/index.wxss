.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f4f7fb}.profile-hero{padding:38rpx;display:flex;align-items:center;border-radius:30rpx;color:#fff;box-shadow:0 14rpx 32rpx rgba(28,57,86,.18)}.avatar{width:108rpx;height:108rpx;margin-right:26rpx;display:flex;align-items:center;justify-content:center;border:5rpx solid rgba(255,255,255,.5);border-radius:50%;background:rgba(255,255,255,.18);font-size:40rpx;font-weight:700}.profile-main{display:flex;flex-direction:column}.account-name{font-size:35rpx;font-weight:700}.phone{margin-top:8rpx;font-size:24rpx;opacity:.9}.role-tag{align-self:flex-start;margin-top:13rpx;padding:7rpx 14rpx;border-radius:20rpx;background:rgba(255,255,255,.2);font-size:20rpx}.status-card{position:relative;margin:-18rpx 18rpx 0;padding:27rpx 10rpx;display:flex;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(27,53,82,.08)}.status-card>view{flex:1;display:flex;flex-direction:column;align-items:center}.status-value{font-size:24rpx;font-weight:700}.status-label{margin-top:7rpx;color:#98a3b1;font-size:19rpx}.section-title{display:block;margin:34rpx 6rpx 16rpx;color:#17283c;font-size:31rpx;font-weight:700}.menu-card{padding:0 26rpx;border-radius:24rpx;background:#fff}.menu-row{min-height:112rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f4}.menu-row:last-child{border-bottom:0}.menu-icon{width:60rpx;height:60rpx;margin-right:18rpx;display:flex;align-items:center;justify-content:center;border-radius:17rpx;font-size:23rpx;font-weight:700}.security{background:#e7f3fc;color:#1677c8}.notice{background:#fff2df;color:#d27a12}.record{background:#e8f8f1;color:#168960}.help{background:#f1ebff;color:#7856bd}.menu-main{flex:1}.menu-main text:first-child{display:block;color:#2d4055;font-size:26rpx;font-weight:600}.menu-main text:last-child{display:block;margin-top:5rpx;color:#99a4b1;font-size:19rpx}.arrow{color:#a1abb7;font-size:40rpx}.logout{margin-top:28rpx;border-radius:14rpx;background:#fff;color:#d14343;font-size:26rpx}.logout::after{border-color:#e5e9ee}.version{display:block;margin-top:22rpx;color:#a2acb8;font-size:19rpx;text-align:center}

<view class="page">
  <view class="section">
    <view class="title">选择演示身份</view>
    <view class="subtitle">当前为静态交互原型，先用身份入口模拟后续真实登录后的角色跳转。</view>
  </view>

  <view class="list-gap">
    <view wx:for="{{roles}}" wx:key="key" class="role-card" bindtap="chooseRole" data-url="{{item.url}}">
      <view>
        <view class="role-title">{{item.title}}</view>
        <view class="role-desc">{{item.desc}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="section reset">
    <button class="btn ghost" bindtap="resetDemo">重置演示数据</button>
  </view>
</view>

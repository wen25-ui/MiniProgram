<view class="page">
  <view class="section">
    <view class="title">商家佣金记录</view>
    <view class="subtitle">客户订单核销后锁定商家 10% 佣金，可标记结算。</view>
  </view>
  <view wx:if="{{orders.length}}" class="list-gap">
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <view class="row">
        <view>
          <view class="strong">{{item.merchantName}}</view>
          <view class="muted">{{item.customerName}} · {{item.id}}</view>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>
      <view class="divider"></view>
      <view class="row"><text class="muted">预计佣金</text><text class="money">{{item.expectedCommissionText}}</text></view>
      <view class="row"><text class="muted">已锁定佣金</text><text class="money">{{item.lockedCommissionText}}</text></view>
      <view class="row"><text class="muted">已结算佣金</text><text class="money">{{item.settledCommissionText}}</text></view>
      <view class="row"><text class="muted">佣金状态</text><text>{{item.commissionStatus}}</text></view>
      <button wx:if="{{item.canSettle}}" class="btn action" data-id="{{item.id}}" bindtap="settle">标记商家佣金已结算</button>
    </view>
  </view>
  <empty-state wx:else title="暂无佣金记录" desc="核销后会生成佣金记录"></empty-state>
</view>

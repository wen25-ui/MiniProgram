<view class="page">
  <view class="section">
    <view class="title">办理进度</view>
    <view class="subtitle">查看所有订单的统一状态码和最新操作记录。</view>
  </view>
  <view wx:if="{{orders.length}}" class="list-gap">
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <view class="row">
        <view>
          <view class="strong">{{item.customerName}} · {{item.maskedPhone}}</view>
          <view class="muted">{{item.id}}</view>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>
      <view class="divider"></view>
      <view class="muted">{{item.latestText}}</view>
      <view class="muted">{{item.latestTime}}</view>
    </view>
  </view>
  <empty-state wx:else title="暂无订单"></empty-state>
</view>

<view class="page">
  <view class="section">
    <view class="title">数据概览</view>
    <view class="subtitle">管理端统一处理审核、派单、核销、返费和佣金结算。</view>
  </view>

  <view class="grid-2 section">
    <money-card label="总订单" amount="{{dashboard.totalOrders || 0}}" note="全部状态"></money-card>
    <money-card label="待审核" amount="{{dashboard.waitReview || 0}}" note="待公司人工审核"></money-card>
    <money-card label="待派单" amount="{{dashboard.waitDispatch || 0}}" note="待指派业务员"></money-card>
    <money-card label="待核销" amount="{{dashboard.waitVerify || 0}}" note="待公司确认凭证"></money-card>
    <money-card label="待退费" amount="{{dashboard.waitRefund || 0}}" note="待客户返费"></money-card>
    <money-card label="已锁定佣金" amount="{{dashboard.lockedCommissionText || '¥0'}}" note="核销生成"></money-card>
  </view>

  <view class="list-gap">
    <view wx:for="{{menus}}" wx:key="url" class="menu" bindtap="openMenu" data-url="{{item.url}}">
      <view>
        <view class="strong">{{item.title}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>

<view class="page">
  <view class="section">
    <view class="title">客户返费记录</view>
    <view class="subtitle">核销成功后生成待退费记录，可标记客户已退费。</view>
  </view>
  <view wx:if="{{orders.length}}" class="list-gap">
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <view class="row">
        <view>
          <view class="strong">{{item.customerName}} · {{item.maskedPhone}}</view>
          <view class="muted">{{item.id}}</view>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>
      <view class="divider"></view>
      <view class="row"><text class="muted">返费金额</text><text class="money">{{item.expectedRefundText}}</text></view>
      <view class="row"><text class="muted">退费状态</text><text>{{item.refundStatus}}</text></view>
      <button wx:if="{{item.canRefund}}" class="btn action" data-id="{{item.id}}" bindtap="markRefunded">标记客户已退费</button>
    </view>
  </view>
  <empty-state wx:else title="暂无返费记录" desc="公司核销后会生成返费记录"></empty-state>
</view>

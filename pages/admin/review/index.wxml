<view class="page">
  <view class="section">
    <view class="title">待审核客户</view>
    <view class="subtitle">人工审核通过后订单进入待派单。</view>
  </view>
  <view wx:if="{{loading}}" class="panel muted">加载中...</view>
  <view wx:elif="{{orders.length}}" class="list-gap">
    <order-card wx:for="{{orders}}" wx:key="id" order="{{item}}" showMerchant="{{true}}" bind:taporder="openDetail"></order-card>
  </view>
  <empty-state wx:else title="暂无待审核" desc="客户提交申请后会出现在这里"></empty-state>
</view>

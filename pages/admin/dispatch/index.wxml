<view class="page">
  <view class="section">
    <view class="title">指派业务员</view>
    <view class="subtitle">审核通过的订单会进入待派单，在这里指派给业务员。</view>
  </view>
  <view wx:if="{{orders.length}}" class="list-gap">
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <order-card order="{{item}}" showMerchant="{{true}}"></order-card>
      <view class="field">
        <text class="label">选择业务员</text>
        <picker range="{{salesmen}}" range-key="name" bindchange="onPick" data-id="{{item.id}}">
          <view class="picker-text">{{item.selectedSalesmanName}}</view>
        </picker>
      </view>
      <button class="btn dispatch-btn" data-id="{{item.id}}" bindtap="dispatch">确认派单</button>
    </view>
  </view>
  <empty-state wx:else title="暂无待派单" desc="审核通过后会出现在这里"></empty-state>
</view>

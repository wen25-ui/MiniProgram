.voucher {
  position: relative;
  margin-top: 22rpx;
  height: 240rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #eef1f5;
}

.voucher image {
  width: 100%;
  height: 240rpx;
}

.voucher text {
  position: absolute;
  left: 24rpx;
  bottom: 18rpx;
  color: #fff;
  background: rgba(16, 32, 51, 0.72);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

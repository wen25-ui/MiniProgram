<view class="page">
  <view class="section">
    <view class="title">核销凭证</view>
    <view class="subtitle">确认核销后生成客户返费和商家 10% 锁定佣金。</view>
  </view>
  <view wx:if="{{orders.length}}" class="list-gap">
    <view wx:for="{{orders}}" wx:key="id" class="panel">
      <order-card order="{{item}}" showSalesman="{{true}}"></order-card>
      <view class="voucher" wx:if="{{item.voucherImage}}" bindtap="preview" data-url="{{item.voucherImage}}">
        <image src="{{item.voucherImage}}" mode="aspectFill"></image>
        <text>查看凭证</text>
      </view>
      <view class="action-grid">
        <button class="btn danger" data-id="{{item.id}}" bindtap="back">退回修改</button>
        <button class="btn" data-id="{{item.id}}" bindtap="confirm">确认核销</button>
      </view>
    </view>
  </view>
  <empty-state wx:else title="暂无待核销" desc="业务员提交凭证后会出现在这里"></empty-state>
</view>

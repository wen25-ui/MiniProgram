page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #172033;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e7ebf2;
  border-radius: 12rpx;
  padding: 26rpx;
  box-sizing: border-box;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #102033;
}

.subtitle {
  margin-top: 10rpx;
  color: #647084;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: #738096;
}

.strong {
  color: #102033;
  font-weight: 700;
}

.money {
  color: #c56b00;
  font-weight: 800;
}

.btn {
  height: 88rpx;
  border-radius: 10rpx;
  background: #1f5fbf;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
  margin: 0;
}

.btn::after {
  border: 0;
}

.btn.secondary {
  background: #eef3fb;
  color: #1f5fbf;
}

.btn.danger {
  background: #b3261e;
}

.btn.ghost {
  background: #fff;
  color: #344054;
  border: 1rpx solid #d7deea;
}

.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e6eaf0;
  box-sizing: border-box;
  z-index: 10;
}

.fixed-spacer {
  height: 140rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #344054;
  font-weight: 600;
}

input,
picker,
textarea {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #d7deea;
  border-radius: 10rpx;
  background: #fff;
  padding: 0 22rpx;
  box-sizing: border-box;
}

textarea {
  padding-top: 20rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.list-gap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.divider {
  height: 1rpx;
  background: #e8edf5;
  margin: 22rpx 0;
}

page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172d47;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

button {
  box-sizing: border-box;
  font-family: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  color: #263b53;
  font-family: inherit;
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e7ecf3;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(25, 53, 83, 0.055);
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #102033;
}

.subtitle {
  margin-top: 10rpx;
  color: #647084;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: #738096;
}

.strong {
  color: #102033;
  font-weight: 700;
}

.money {
  color: #c56b00;
  font-weight: 800;
}

.btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1d5fa2, #2e7ac0);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
  margin: 0;
}

.btn::after {
  border: 0;
}

.btn.secondary {
  background: #eef3fb;
  color: #1f5fbf;
}

.btn.danger {
  background: #b3261e;
}

.btn.ghost {
  background: #fff;
  color: #344054;
  border: 1rpx solid #d7deea;
}

.fixed-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e6eaf0;
  box-sizing: border-box;
  z-index: 10;
}

.fixed-spacer {
  height: 140rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #344054;
  font-weight: 600;
}

input,
picker,
textarea {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #d7deea;
  border-radius: 15rpx;
  background: #f9fbfd;
  padding: 0 22rpx;
  box-sizing: border-box;
}

textarea {
  padding-top: 20rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.list-gap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.divider {
  height: 1rpx;
  background: #e8edf5;
  margin: 22rpx 0;
}

.sticky-filter {
  position: sticky;
  top: 0;
  z-index: 20;
  padding-bottom: 2rpx;
  background: #f4f7fb;
}
